# 0x58 — tailnet nodes from dev/nodes/. Placed by restore.sh; edits are overwritten.
#
# An Include fragment rather than a full ~/.ssh/config, so private hosts stay
# local and unversioned while the reproducible parts live in git.
#
# Short MagicDNS names, not FQDNs. Two reasons: the tailnet search domain makes
# `pezware-devbox` resolve on its own, and an FQDN would bake this tailnet's
# identifier into a PUBLIC repository for no benefit. If short names ever stop
# resolving, check that the Mac has `--accept-dns=true` — that is what installs
# the search domain.

Host devbox pezware-devbox
    HostName pezware-devbox
    User arbeitandy

    # NOT forwarded, as of 2026-08-04. This used to be `yes`, justified as making
    # "git push and commit signing on the devbox use the Mac's Secure Enclave
    # key". That stopped being true when agents were given their own on-disk key:
    # user.signingkey is a path and IdentityFile pins the same key for github.com,
    # so pushes and signatures never touched the forwarded agent. It was carrying
    # risk for a benefit nothing consumed.
    #
    # The risk was not theoretical once AF_UNIX opened up for container tests
    # (linux/sandbox.md): a sandboxed agent can now reach any unix socket, and
    # ~620 stale /tmp/auth-agent*/ sockets had accumulated on the box, live ones
    # still answering with both Secure Enclave keys.
    #
    # `sign-push` is the one thing that genuinely needs it, and it already tells
    # you to connect with `ssh -A` — opt in per invocation:
    #     ssh -A devbox
    ForwardAgent no

    # The devbox is deliberately disposable, and tailscaled regenerates its host
    # key on every rebuild — so a persisted known_hosts entry would produce a
    # mismatch warning after each one. Training yourself to click through those
    # is worse than not storing the key at all.
    #
    # What this gives up is small: the connection is already authenticated and
    # encrypted by WireGuard before SSH starts, and peer identity comes from the
    # tailnet. Forging it means already owning the tailnet, at which point the
    # SSH host key was never the control that mattered.
    UserKnownHostsFile /dev/null
    StrictHostKeyChecking accept-new
    LogLevel ERROR

# The on-demand kind host. Same reasoning, more so: created and destroyed per
# session, so it churns host keys even faster than the devbox.
Host k8s pezware-k8s
    HostName pezware-k8s
    User arbeitandy
    # Never forward here. This is the box that exists to run code we do not
    # trust — handing it live use of the Secure Enclave keys inverts the entire
    # point of having a disposable node.
    ForwardAgent no
    UserKnownHostsFile /dev/null
    StrictHostKeyChecking accept-new
    LogLevel ERROR
