apiVersion: v1
clusters:
  - cluster:
        server: https://europe-west4-connectgateway.googleapis.com/v1/projects/1090626497061/locations/europe-west4/gkeMemberships/iden2-staging-gke
    name: gke-stg-admin
contexts:
  - context:
        cluster: gke-stg-admin
        user: gke-stg-admin
    name: gke-stg-admin
current-context: orbstack
kind: Config
users:
  - name: gke-stg-admin
    user:
        exec:
            apiVersion: client.authentication.k8s.io/v1beta1
            args: null
            command: gke-gcloud-auth-plugin
            env:
              - name: CLOUDSDK_ACTIVE_CONFIG_NAME
                value: stg-admin-rw
            installHint: Install gke-gcloud-auth-plugin for use with kubectl by following https://cloud.google.com/kubernetes-engine/docs/how-to/cluster-access-for-kubectl#install_plugin
            interactiveMode: IfAvailable
            provideClusterInfo: true
