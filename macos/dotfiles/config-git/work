# Work identity (arbeitandy), included for ~/src/iden2/ and ~/src/phenix-id/ on
# both machines. There is no global identity: a repo outside the identity trees
# refuses to commit (user.useConfigOnly). See setup_git_identity in
# macos/restore.sh.
[user]
	name = Andy Xiang
	email = andy@iden2.com
	signingkey = key::ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBHtka53TISNw3+5ybiF6VIiV79Q2fkBUKBgX/NdKa+bAKcHw7rAlPetisbFoHu3U12kmAbJaSJnqMOEdvfF56/w= andy@iden2.com
# The push key; see the note in personal.
[core]
	sshCommand = /opt/homebrew/bin/ssh -F /dev/null -o IdentitiesOnly=yes -o IdentityAgent=~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh -o IdentityFile=~/.ssh/secretive_work.pub
# Every GitHub remote goes over ssh, so core.sshCommand decides the account.
# Both includes rewrite to the same target, so their order cannot matter here.
[url "git@github.com:"]
	insteadOf = https://github.com/
	insteadOf = ssh://git@github.com/
