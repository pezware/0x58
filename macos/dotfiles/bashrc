# ~/.bashrc - Interactive shell configuration
# This handles all interactive shell settings

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# History settings
HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
HISTTIMEFORMAT='%Y-%m-%d %H:%M.%S | '
HISTIGNORE="ls:exit:history:[bf]g:jobs"
shopt -s histappend

# Basic aliases for all environments
#
# `vim` is aliased only where nvim actually exists. This file is placed verbatim
# on both machines, and the devbox deliberately has no nvim as of 2026-08-05 — an
# unconditional alias there makes every `vim` invocation, including the ones you
# reach for when something is already broken, fail with "command not found".
# Probing for the binary rather than the platform keeps this correct if either
# machine changes its mind.
if command -v nvim >/dev/null 2>&1; then
    alias vi=nvim
    alias vim=nvim
fi
alias cp="cp -i"
# `cat` -> bat on macOS only. On a remote box it actively gets in the way: bat
# paginates and adds line numbers and decorations, so reading a file in an ssh
# tmux pane produces output you cannot cleanly copy. It also muddies debugging —
# during sandbox verification `cat` of a denied path returned bat's formatting
# instead of the plain read failure, which made a working deny look ambiguous.
# Keep the real cat where you are inspecting things over a wire.
if [[ "$OSTYPE" == "darwin"* ]]; then
    alias cat=bat
fi
alias less="less -r"
alias ls="ls --color=auto"
alias ll="ls --color"
alias weather='curl wttr.in'
alias vpn='curl ifconfig.me;echo'
alias config='git --git-dir=$HOME/.mydot/ --work-tree=$HOME'
# Pin codex TUI to a ChatGPT-account-supported model. The TUI otherwise inherits
# the model from the last thread in the cwd, which stuck on the retired
# 'gpt-5-codex' and 400s on ChatGPT auth. -m overrides that; codex exec/plugins
# pass their own model so they're unaffected.
#
# Sandbox hardening is deliberately NOT here. It used to ride on a `-p devbox`
# profile selected by this alias, which meant it applied only to interactive
# shells — Claude Code's Bash tool and any script got the unhardened defaults.
# It now lives in ~/.codex/config.toml on Linux (see linux/codex-hardening.toml),
# so every invocation path gets it and this wrapper only picks a model.
_CODEX_FLAGS=(-m gpt-5.6-sol)

# A function, not an alias, because -p and -m are only valid on RUNTIME
# subcommands. An alias prepends them to everything, so `codex login` failed with
# "--profile only applies to runtime commands" — which is a confusing way to
# discover your own shell config is in the way while you are trying to log in.
#
# Default is to add the flags (bare `codex`, `codex exec`, and `codex "prompt"`
# all want them); only the housekeeping subcommands pass through untouched.
codex() {
    case "${1:-}" in
        login|logout|completion|help|--help|-h|--version|-V)
            command codex "$@" ;;
        *)
            command codex "${_CODEX_FLAGS[@]}" "$@" ;;
    esac
}

# PATH setup - ensure critical directories are in PATH
# ~/go/bin and ~/.cargo/bin intentionally excluded — manage Rust/Go tools via mise
# (project .mise.toml). Only ~/.cargo/bin user is mempal — handled there.
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && [ -d "$HOME/.local/bin" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# Development environment
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
[ -f "$HOME/.deno/env" ] && source "$HOME/.deno/env"
[ -f "$HOME/.env" ] && source "$HOME/.env"

# Source modular configurations
for config in ~/.bash/{aws,go,history,prompt,work_alias,glow,kubectl-context,gpg-keychain,gcloud-session}.bash; do
    [ -f "$config" ] && source "$config"
done

# OS-specific configurations
if [[ "$OSTYPE" == "darwin"* ]]; then
    [ -f ~/.bash/macos.bash ] && source ~/.bash/macos.bash
else
    # Linux Completion
    [ -f "/usr/share/bash-completion/bash_completion" ] && . "/usr/share/bash-completion/bash_completion"
    [ -f "/usr/local/bin/eksctl" ] && source <(eksctl completion bash)
    [ -f "$HOME/.local/share/bash-completion/completions/deno.bash" ] && source "$HOME/.local/share/bash-completion/completions/deno.bash"
fi

# --- macOS-only environment -------------------------------------------------
# restore.sh copies this file verbatim onto Linux boxes, and these exports are
# hardcoded to macOS paths. Two of them are actively harmful there:
#   - /usr/libexec/java_home does not exist -> an error on every interactive shell
#   - pinning SSH_AUTH_SOCK to the Secretive socket CLOBBERS a forwarded agent,
#     silently breaking git-over-SSH after `ssh -A` into the box
if [[ "$OSTYPE" == "darwin"* ]]; then
    export JAVA_HOME="$(/usr/libexec/java_home -v 17)"
    export SSH_AUTH_SOCK="$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
    export PNPM_HOME="$HOME/Library/pnpm"
    export PATH="/opt/homebrew/share/google-cloud-sdk/bin:/usr/local/bin:$PATH"
    # Telemetry opt-out stays ON here. The Mac never needs Remote Control.
    export DO_NOT_TRACK=1
else
    # Leave SSH_AUTH_SOCK untouched so a forwarded agent survives — this is what
    # lets the devbox sign and push with the Mac's Secure Enclave key, Touch-ID
    # gated, without any private key ever reaching this machine.
    #
    # ...but pin every shell to a STABLE path. The forwarded socket lives at a
    # per-connection path (/tmp/auth-agentNNNN/listener.sock) that dies with the
    # connection, so a tmux pane created during one session holds a dead path the
    # next time you attach, and sign-push then refuses with "no SSH agent keys".
    # Re-pointing one symlink means long-lived panes keep working across
    # reconnects without their environment ever being touched: the target moves
    # underneath them. Fix the indirection rather than chase the value.
    if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK:-}" ] \
       && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/agent.sock" ]; then
        mkdir -p "$HOME/.ssh" && ln -sfn "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock"
    fi
    # -S follows the symlink, so a dangling one is simply not adopted.
    if [ -S "$HOME/.ssh/agent.sock" ]; then
        export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
    fi
    export PNPM_HOME="$HOME/.local/share/pnpm"
    # The per-boot unit creates the tmux session via `sudo -u`, which has no
    # login session and therefore no XDG_RUNTIME_DIR. Every shell inside that
    # session then fails `systemctl --user` with "Failed to connect to user scope
    # bus" — which reads like systemd is broken rather than like a missing env
    # var. Set it when absent; systemd --user is already running under this uid.
    if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
        export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    fi
    # Rootless podman speaks the Docker API on a socket under the user runtime
    # dir, which is what testcontainers-go probes for via DOCKER_HOST. Ryuk, its
    # reaper sidecar, wants to watch the engine from a privileged container that
    # rootless podman will not grant, so turn it off and let podman reap.
    #
    # Set only when the socket is actually there. Exporting DOCKER_HOST to a
    # path that does not exist is worse than leaving it unset: testcontainers
    # then reports a connection failure to a specific socket instead of its far
    # clearer "could not find a valid Docker environment".
    #
    # This serves YOUR shell and CI, never agents. The sandbox's seccomp filter
    # blocks AF_UNIX wholesale, so a sandboxed `go test -tags=e2e` cannot reach
    # this socket whatever DOCKER_HOST says — verified, curl exits 7 inside the
    # sandbox and 0 outside it. That is the same filter that keeps agents off
    # the forwarded SSH agent, so it is load-bearing, not incidental.
    if [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock" ]; then
        export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
        export TESTCONTAINERS_RYUK_DISABLED=true
    fi
    # DO_NOT_TRACK disables the feature-flag evaluation Claude Code's Remote
    # Control depends on, so it is 0 here and only here. Scoped to Linux
    # deliberately: the phone path lives on the devbox, and the Mac's privacy
    # posture should not change as a side effect of enabling it.
    export DO_NOT_TRACK=0
fi

case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

export GPG_TTY=$(tty)
export MEMPAL_HOME="~/src/.mempal"
export GOOGLE_CLOUD_QUOTA_PROJECT=""
eval "$(mise activate bash)"

# ~/.local/bin must WIN, and this has to come after `mise activate` to do it.
#
# The one that matters is `gh`. ~/.local/bin/gh is the wrapper that selects a
# fine-grained PAT by the repo's owner; ~/.local/share/mise/shims/gh is raw gh
# with no credential, and answers "please run gh auth login" — an error that
# reads like a broken install rather than a shadowed binary. On 2026-08-04 that
# cost a session real time.
#
# Unconditional, unlike the earlier guard near the top of this file. That one is
# `if PATH does not already contain ~/.local/bin`, which silently does nothing
# when the directory is present but LAST — exactly the case that needs fixing.
# Filter it out first, then prepend, so re-sourcing cannot grow PATH without
# bound either.
if [ -d "$HOME/.local/bin" ]; then
    PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$HOME/.local/bin" | paste -sd: -)
    export PATH="$HOME/.local/bin:$PATH"
fi
