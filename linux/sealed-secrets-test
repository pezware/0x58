#!/usr/bin/env bash
#
# sealed-secrets-test — boot Debian 13 under systemd in a container and prove the
# sealed-secret units work: linux/ssh-agent and every linux/secret-broker route.
#
#   linux/sealed-secrets-test          # from the Mac, podman machine running
#
# Uses fake keys only and spends nothing: each route must reach its upstream and
# be REFUSED there (400/401), which proves the broker injected the fake key.
# Run it after you add a route or change a unit, before the devbox sees it.
#
# Two container artifacts, both handled here, neither present on a real boot:
#   - rootless podman cannot deliver systemd credentials, so this uses the
#     machine's rootful connection;
#   - podman mounts /run private, so a credentials tmpfs built in a helper
#     namespace never reaches the unit. `mount --make-rshared /run` fixes it.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# podman on the Mac mounts /Users only, so the fixtures live under $HOME.
WORK="$HOME/.cache/sealed-secrets-test"
NAME=sealed-secrets-test
P=(podman -c "${PODMAN_CONNECTION:-podman-machine-default-root}")

rm -rf "$WORK"; mkdir -p "$WORK/bin"
trap '"${P[@]}" rm -f "$NAME" >/dev/null 2>&1 || true' EXIT

echo "== build"
(cd "$REPO/linux/secret-broker" && CGO_ENABLED=0 GOOS=linux GOARCH="$("${P[@]}" info --format '{{.Host.Arch}}')" \
    go build -trimpath -o "$WORK/bin/secret-broker.prebuilt" .)
# The image has no Go 1.26; this shim stands in for `go build -o OUT .`.
cat > "$WORK/bin/go" <<'EOF'
#!/bin/sh
out=""; while [ $# -gt 0 ]; do [ "$1" = "-o" ] && out="$2"; shift; done
cp /opt/test/bin/secret-broker.prebuilt "$out"
EOF
chmod +x "$WORK/bin/go"
cat > "$WORK/Containerfile" <<'EOF'
FROM docker.io/library/debian:trixie
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      systemd systemd-sysv dbus openssh-client curl sudo ca-certificates git >/dev/null \
 && useradd -m -u 1000 -s /bin/bash arbeitandy \
 && echo 'arbeitandy ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/arbeitandy
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
EOF
"${P[@]}" build -q -t "$NAME:trixie" "$WORK" >/dev/null

echo "== boot"
"${P[@]}" rm -f "$NAME" >/dev/null 2>&1 || true
"${P[@]}" run -d --name "$NAME" --privileged --systemd=always \
    -v "$REPO:/repo:ro" -v "$WORK:/opt/test:ro" "$NAME:trixie" >/dev/null
sleep 4
"${P[@]}" exec "$NAME" bash -c 'mount --make-rshared /run && cp -r /repo /home/arbeitandy/0x58 && chown -R arbeitandy: /home/arbeitandy/0x58'

echo "== test"
# -i, or podman passes no stdin and bash -s runs an empty script that "passes".
"${P[@]}" exec -i -u arbeitandy -w /home/arbeitandy "$NAME" bash -s <<'EOF'
set -uo pipefail
export PATH=/opt/test/bin:$PATH
fail=0; ran=0
check() { ran=$((ran + 1)); if [ "$2" = "$3" ]; then echo "  ok   $1"; else echo "  FAIL $1: got '$2', want '$3'"; fail=1; fi; }
quiet() { "$@" >/dev/null 2>&1; }

g=$(mktemp -d)
for k in devbox_agent devbox_agent_personal; do ssh-keygen -q -t ed25519 -N "" -C "$k@test" -f "$g/$k"; done
mkdir -p ~/.ssh && chmod 700 ~/.ssh && cp "$g/devbox_agent" ~/.ssh/ && chmod 600 ~/.ssh/devbox_agent
for k in devbox_agent devbox_agent_personal; do quiet 0x58/linux/ssh-agent/install --seal "$k" < "$g/$k"; done
rm -rf "$g"
agent() { SSH_AUTH_SOCK=/run/ssh-agent-arbeitandy/agent.sock ssh-add -l 2>/dev/null | wc -l | tr -d ' '; }
check "agent holds both sealed keys" "$(agent)" 2
check "legacy private key removed" "$(test -e ~/.ssh/devbox_agent && echo present || echo gone)" gone
check "ciphertext unreadable to uid 1000" "$(cat /etc/credstore.encrypted/ssh-devbox_agent >/dev/null 2>&1 && echo read || echo denied)" denied

d=$(mktemp -d); (cd "$d" && env -u SSH_AUTH_SOCK bash -c '
  git init -q . && git config user.email t@t && git config user.name t && git config gpg.format ssh
  git config user.signingkey ~/.ssh/devbox_agent_personal.pub
  git config gpg.ssh.program ~/.local/bin/devbox-ssh-keygen
  printf "t@t %s\n" "$(cat ~/.ssh/devbox_agent_personal.pub)" > s && git config gpg.ssh.allowedSignersFile "$PWD/s"
  git commit -q --allow-empty -S -m t') >/dev/null 2>&1
check "git signs with no SSH_AUTH_SOCK" "$(git -C "$d" log --format=%G? -1 2>/dev/null)" G

pid() { systemctl show -p MainPID --value devbox-ssh-agent@arbeitandy; }
before=$(pid); sudo systemctl kill -s KILL devbox-ssh-agent@arbeitandy; sleep 5
check "a killed agent is restarted" "$([ "$(pid)" != "$before" ] && [ "$(pid)" != 0 ] && echo new || echo same)" new
check "keys reload after the agent dies" "$(agent)" 2

printf 'sk-wrong' | quiet 0x58/linux/secret-broker/install --seal xai
check "wrong key prefix is not sealed" "$(sudo test -e /etc/credstore.encrypted/xai && echo sealed || echo refused)" refused

code() { curl -s -o /dev/null -w '%{http_code}' --unix-socket "/run/$1-broker/$1.sock" "${@:2}"; }
printf 'xai-fake' | quiet 0x58/linux/secret-broker/install --seal xai
check "xai: upstream refuses the injected fake" "$(code xai -H 'Authorization: Bearer placeholder' http://xai/v1/models)" 400
printf 'fake' | quiet 0x58/linux/secret-broker/install --seal linode
check "linode: upstream refuses the injected fake" "$(code linode http://linode/v4/profile)" 401
printf 'kFAKE:tskey-client-kFAKE-0' | quiet 0x58/linux/secret-broker/install --seal tailscale
check "tailscale: failed token exchange answers 502" "$(code tailscale -X POST -d '{}' http://tailscale/api/v2/tailnet/-/keys)" 502
check "tailscale: a key id path is not proxied" "$(code tailscale -X DELETE http://tailscale/api/v2/tailnet/-/keys/k1)" 404
echo "  $ran checks"
[ "$ran" -eq 11 ] || { echo "  FAIL expected 11 checks"; fail=1; }
exit "$fail"
EOF
