# The scoped devbox Linode PAT (Linodes + Volumes RW, Events RO), used by
# `ts-node k8s`. Callers: /run/linode-broker/linode.sock, path /v4/...
BROKER_UPSTREAM=https://api.linode.com
BROKER_PATH=/v4/
# A terraform apply polls instance status every few seconds for minutes.
BROKER_RPM=300
BROKER_ESCROW_ITEM=linode-pat-devbox
