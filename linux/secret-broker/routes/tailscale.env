# Mints Tailscale auth keys for `ts-node k8s`, and nothing else. The credential
# is an OAuth client "<client_id>:<client_secret>" with the auth_keys scope and
# tag:k8s only, so every key it can mint joins as tag:k8s.
# Callers: /run/tailscale-broker/tailscale.sock, POST /api/v2/tailnet/-/keys
BROKER_UPSTREAM=https://api.tailscale.com
# An exact path, not a subtree: the broker refuses /keys/<id>, so a caller can
# create and list keys but cannot delete or read one by id.
BROKER_PATH=/api/v2/tailnet/-/keys
BROKER_AUTH=oauth2
BROKER_TOKEN_URL=https://api.tailscale.com/api/v2/oauth/token
BROKER_KEY_PREFIX=tskey-client-
BROKER_RPM=10
BROKER_ESCROW_ITEM=tailscale-k8s-oauth
