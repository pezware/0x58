# secret-broker@<route> — the devbox agent gets an API endpoint, never the key.
#
# One instance per route. The route file /etc/secret-broker/<route>.env says
# where to forward and which header to set (routes/*.env in this directory).
# The key is sealed with `systemd-creds encrypt --with-key=host` into
# /etc/credstore.encrypted/<route> (root, 0600). PID 1 decrypts it into a
# private tmpfs for this unit only, and the broker reads it from
# $CREDENTIALS_DIRECTORY. A sandboxed agent running as uid 1000 cannot read
# either the ciphertext or the host key, and cannot sudo (no_new_privs).
#
# Install and rotate with linux/secret-broker/install. This is a SYSTEM unit,
# which is why it sits in a subdirectory: devbox-drift treats linux/*.service as
# user units and would report it as never enabled.
#
# Callers: curl --unix-socket /run/<route>-broker/<route>.sock http://<route>/...
# Audit:   journalctl -u secret-broker@<route>   (uid, pid, method, path, status)

[Unit]
Description=secret broker for %i (credential-injecting proxy on a unix socket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/secret-broker
# The socket path keeps the xai route at /run/xai-broker/xai.sock, where
# smallscreen-books looks by default. EnvironmentFile= wins over Environment=,
# so a route file could move either value; install refuses one that tries.
Environment=BROKER_SOCKET=/run/%i-broker/%i.sock
Environment=BROKER_CREDENTIAL=%i
EnvironmentFile=/etc/secret-broker/%i.env
LoadCredentialEncrypted=%i:/etc/credstore.encrypted/%i
RuntimeDirectory=%i-broker
RuntimeDirectoryMode=0755
DynamicUser=yes
Restart=on-failure
RestartSec=5

# Nothing below is load-bearing for the secret; the credential path above is.
# It bounds what a bug in the proxy could reach.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
