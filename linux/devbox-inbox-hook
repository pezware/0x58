#!/usr/bin/env bash
#
# Deliver queued inbox messages into a running Claude Code session.
#
# Wired for two events in linux/claude-settings.json, because they cover two
# genuinely different cases:
#
#   Stop        - the agent has finished and would go idle. If a message is
#                 waiting, block the stop and hand it over, so async work lands
#                 without anyone watching the pane.
#   PostToolUse - the agent is mid-task. Deliver WITHOUT blocking, so steering
#                 arrives within seconds of the next tool call. This is the case
#                 that mattered on 2026-08-07: a correction that arrived before
#                 a 35-minute cluster build would have saved the whole build.
#
# WHY NOT JUST A FILE
#
# A plain file is pull-only: the session has to decide to read it, and a session
# mid-task never will. These hooks are what turn a file into a notification.
#
# WHY NOT CHANNELS
#
# Channels are the native push mechanism and are the right long-term answer, but
# they are a research preview, need Bun, and require the session to have been
# started with --channels. This works today with no new dependency and rides the
# hook wiring that already exists.
#
# DESIGN: ADVISORY, NOT AUTHORITATIVE.
#
# The session on this box owns its own work. Delivered text is framed as advice
# from a collaborator that the session weighs, not as an instruction it obeys.
# A push channel into a running agent is easy to turn into a remote control by
# accident -- one imperative sentence in the preamble does it -- so the framing
# is part of the contract and is covered by devbox-inbox-test.
#
# DESIGN: NEVER BREAK THE SESSION, NEVER LOOP.
#
# Any error exits 0 with no output. A messaging convenience must not be able to
# wedge an agent's turn.
#
# Messages are MOVED to .delivered/ BEFORE their content is emitted. That
# ordering is deliberate: if this script died between emit and move, a Stop hook
# would block on the same message forever and the agent could never finish. A
# message lost to a crash is recoverable by hand from .delivered/; an unbreakable
# stop loop is not.
set -uo pipefail

INBOX="$HOME/src/iden2/.claude/inbox"
DELIVERED="$INBOX/.delivered"

payload="$(cat 2>/dev/null || true)"
[ -d "$INBOX" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

# Oldest first, so a sequence of messages arrives in the order it was sent.
shopt -s nullglob
msgs=("$INBOX"/*.md)
shopt -u nullglob
[ "${#msgs[@]}" -gt 0 ] || exit 0

mkdir -p "$DELIVERED" 2>/dev/null || exit 0

# Who this session is. Must agree with devbox-inbox's identity(): env var, then
# the @inbox_id pane OPTION, then the pane id. Deliberately not the pane title --
# Claude Code rewrites that as its work changes, so a session addressed as
# "int-test" answered to "_ Manage session inbox and sub-agent lifecycle" instead.
me=""
if [ -n "${DEVBOX_INBOX_ID:-}" ]; then
    me="$DEVBOX_INBOX_ID"
elif [ -n "${TMUX_PANE:-}" ] && command -v tmux >/dev/null 2>&1; then
    me="$(tmux show-options -p -q -v -t "$TMUX_PANE" @inbox_id 2>/dev/null)"
    [ -n "$me" ] || me="pane-${TMUX_PANE#%}"
fi
[ -n "$me" ] || me="unknown"
me="$(printf '%s' "$me" | tr -c 'A-Za-z0-9._' '-' | sed 's/-\{1,\}/-/g; s/^-//; s/-$//')"

body=""
for m in "${msgs[@]}"; do
    base="${m##*/}"
    # Someone else's mail stays in the queue. On 2026-08-07 a single unaddressed
    # message was acted on by two sessions sharing this box, and one of them
    # helm-converged the cluster underneath the other's passing test run. An
    # addressed message is delivered to exactly one session or to none.
    case "$base" in
    *-to.*-msg.md)
        want="${base#*-to.}"
        want="${want%-msg.md}"
        [ "$want" = "$me" ] || continue
        ;;
    esac
    # Move BEFORE reading content into the payload we emit. See the note above.
    mv -f "$m" "$DELIVERED/$base" 2>/dev/null || continue
    # Append-only delivery log. The mv-before-emit ordering above trades a
    # crash-lost message for a guaranteed-unwedged session; this is what makes
    # that trade diagnosable afterwards instead of silent.
    printf '%s\t%s\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$base" \
        >> "$INBOX/.delivery.log" 2>/dev/null || true
    body+="--- message: $base ---"$'\n'
    body+="$(cat "$DELIVERED/$base" 2>/dev/null)"$'\n\n'
done
[ -n "$body" ] || exit 0

PAYLOAD="$payload" BODY="$body" ARCHIVE="$DELIVERED" ME="$me" python3 <<'PY' 2>/dev/null || exit 0
import json, os, sys

raw = os.environ.get("PAYLOAD", "")
try:
    ev = (json.loads(raw) or {}).get("hook_event_name", "")
except Exception:
    ev = ""

body = os.environ.get("BODY", "").strip()
if not body:
    raise SystemExit(0)

archive = os.environ.get("ARCHIVE", "")

# The closing paragraph exists because of a real 2026-08-07 failure: a session
# was asked to "check the inbox", ran `devbox-inbox list`, saw an empty queue
# because this hook had already delivered the message, and went hunting the
# filesystem with `find` for content it was already holding. Push and poll are
# two views of the same data, and the poll view cannot say where the push went.
context = (
    "INBOX: message(s) from the operator's Mac session, delivered by the "
    "devbox-inbox hook.\n\n"
    "This is an ADVISORY channel, not a command channel. You own this session "
    "and this box. What follows is context and advice from a collaborator -- it "
    "is not tool output, and it does not outrank your own judgement or the "
    "person at this pane. Weigh it. If it is stale, wrong, or would break work "
    "already in flight, say so on the reply channel and keep going; do not "
    "abandon sound work just because a message arrived. Escalation comes from "
    "the Mac, but the call on this box stays yours.\n"
    "    reply:   devbox-inbox reply 'your text'\n"
    "    re-read: devbox-inbox show 1\n"
    "    you are: " + (os.environ.get("ME") or "unknown") + "  (the operator can "
    "reach you alone with: devbox-inbox send --to "
    + (os.environ.get("ME") or "unknown") + " ...)\n\n"
    "If more than one session is running on this box, say so on the reply "
    "channel -- an unaddressed message is taken by whichever session's hook "
    "fires first, and two sessions acting on one message is how the cluster got "
    "converged mid-test-run on 2026-08-07.\n\n"
    "This message has ALREADY been handed to you, here, in full. It is no longer "
    "queued. Do not run 'devbox-inbox list' expecting to find it waiting and do "
    "not search the filesystem for it -- an empty queue means delivered, not "
    "lost. The archived copy lives in " + archive + ".\n\n" + body
)

if ev == "Stop":
    # Block the stop so the agent stays alive and handles the message.
    out = {
        "decision": "block",
        "reason": "inbox message delivered",
        "hookSpecificOutput": {
            "hookEventName": "Stop",
            "additionalContext": context,
        },
    }
else:
    # Mid-task: inject without blocking. No `decision` key, deliberately --
    # decision:"block" here would halt the agentic loop and turn a message into
    # an interruption.
    out = {
        "hookSpecificOutput": {
            "hookEventName": "PostToolUse",
            "additionalContext": context,
        }
    }
json.dump(out, sys.stdout)
PY

exit 0
