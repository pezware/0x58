#!/usr/bin/env bash
#
# gh wrapper: pick the fine-grained PAT that matches the repository's owner.
#
# Installed as ~/.local/bin/gh, which is first on PATH.
#
# WHY
#
# A fine-grained PAT has exactly ONE resource owner, and gh holds one credential
# per host — so a single token cannot cover both pezware/* and iden2-com/*. This
# selects by the origin remote's owner instead.
#
# It works because `gh` is in the sandbox's excludedCommands and therefore runs
# OUTSIDE it: the wrapper can read a credentials file that sandboxed commands
# cannot. Same property that lets git use a signing key agents can't cat.
#
# Both tokens are deliberately Contents:READ. An agent holding one cannot push
# over HTTPS — verified, GitHub returns 403 — so every push must go through the
# SSH signing key. That is the gate; the token is not.
#
# Packages are a THIRD principal, not a scope on the other two. A fine-grained
# PAT cannot carry package access at all, so GHCR needs its own classic PAT
# (`read:packages`, and nothing else) — that is `GHCR_TOKEN`, alongside the other
# two in the same credentials file.
#
# It was there, unused, from 2026-08-04 until 2026-08-15, because this wrapper
# only ever selected by owner. Every `gh api /orgs/.../packages` therefore got a
# Contents:READ token and 403'd, and an agent has no way to tell "the token I was
# handed lacks this" from "this box cannot do this" — it reported the box could
# not query GHCR and fell back to weaker evidence. Measured on the same call:
# `GHCR_TOKEN` returns 200 with 60 packages, the owner token returns 403.
#
# Honest limit: `gh auth token` prints whatever is selected, so a determined
# agent can still extract it. Scoping is what bounds the damage, not secrecy.
set -euo pipefail

CREDS="${TS_NODE_CREDS:-$HOME/.config/0x58/credentials.env}"

# Resolve the real gh: the first one on PATH that is not this script. Comparing
# resolved paths matters — a bare name check would re-enter the wrapper forever.
real_gh() {
    local self c
    self=$(readlink -f "$0" 2>/dev/null || echo "$0")
    while IFS= read -r c; do
        [ -n "$c" ] || continue
        [ "$(readlink -f "$c" 2>/dev/null)" = "$self" ] && continue
        printf '%s' "$c"; return 0
    done < <(type -aP gh 2>/dev/null)
    # Fixed paths, deliberately. `mise which gh` was tried first and is the wrong
    # tool: mise is CONTEXT-SENSITIVE — it reads the project's .mise.toml and
    # refuses untrusted config, so it failed in one repo and succeeded in another
    # with identical PATH, making it look like gh did not exist.
    for c in "$HOME/.local/share/mise/shims/gh" "/usr/local/bin/gh" "/usr/bin/gh"; do
        [ -x "$c" ] && { printf '%s' "$c"; return 0; }
    done
    # Last resort: ask mise, tolerating its context sensitivity.
    c=$(mise which gh 2>/dev/null) && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
    return 1
}

GH=$(real_gh) || { echo "gh-wrapper: cannot find the real gh on PATH" >&2; exit 127; }

# An explicit --repo/-R wins over the working directory, because it is a
# STRONGER statement of intent than where the shell happens to be.
#
# This was missing until 2026-08-05 and it mattered: an agent ran
#   gh issue view 1160 --repo iden2-com/go-monorepo
# from ~/src, which is exactly how gh is meant to be used from outside a
# checkout, and got no token — because the wrapper only looked at the origin
# remote. It then told the agent to cd into a repo, advice that was both
# unnecessary and beside the point. gh already knew which repo; the wrapper did
# not bother to look.
#
# gh accepts `[HOST/]OWNER/REPO`, so take the component before the repo name
# rather than assuming the first.
repo_arg=""
prev=""
for a in "$@"; do
    case "$prev" in
        -R|--repo) repo_arg="$a"; break ;;
    esac
    case "$a" in
        --repo=*) repo_arg="${a#--repo=}"; break ;;
        -R=*)     repo_arg="${a#-R=}";     break ;;
    esac
    prev="$a"
done

owner=""
if [ -n "$repo_arg" ]; then
    # Strip any scheme, then keep the OWNER of a trailing owner/repo pair.
    owner=$(printf '%s' "$repo_arg" \
            | sed -E 's#^[a-z]+://##; s#/+$##' \
            | awk -F/ 'NF>=2 { print $(NF-1) }')
fi

# Fall back to the origin remote, from either ssh or https form. Falls through
# silently when not in a repo — `gh --version` and friends still work.
if [ -z "$owner" ]; then
    owner=$(git config --get remote.origin.url 2>/dev/null \
            | sed -E 's#^(git@[^:]+:|https?://[^/]+/)([^/]+)/.*$#\2#' || true)
fi

# Is this call a Packages endpoint? Those need GHCR_TOKEN rather than an owner
# token, and they are reachable ONLY through `gh api` — there is no `gh packages`.
#
# Every argument is scanned rather than just the first non-flag one, because
# `gh api -H 'Accept: …' /orgs/x/packages` puts a header value where the path
# would otherwise be, and matching positionally would silently miss it.
#
# The patterns are anchored on the three real path shapes instead of a bare
# `*packages*`. A repository legitimately named "packages" would otherwise match
# `/repos/owner/packages`, and be handed a token with NO contents access — a call
# that works today would start failing.
packages_endpoint() {
    [ "${1:-}" = api ] || return 1
    local a
    for a in "$@"; do
        case "$a" in
            /user/packages*|user/packages*) return 0 ;;
            /orgs/*/packages*|orgs/*/packages*) return 0 ;;
            /users/*/packages*|users/*/packages*) return 0 ;;
        esac
    done
    return 1
}

if [ -z "${GH_TOKEN:-}" ] && [ -r "$CREDS" ]; then
    # shellcheck disable=SC1090
    . "$CREDS"
    if packages_endpoint "$@" && [ -n "${GHCR_TOKEN:-}" ]; then
        # Deliberately independent of $owner: GHCR_TOKEN covers both orgs, so a
        # packages call works from ~/src, outside any checkout, where the
        # owner-based path has nothing to go on.
        export GH_TOKEN="$GHCR_TOKEN"
    else
        case "$owner" in
            iden2-com) [ -n "${GH_TOKEN_IDEN2:-}" ]   && export GH_TOKEN="$GH_TOKEN_IDEN2" ;;
            pezware)   [ -n "${GH_TOKEN_PEZWARE:-}" ] && export GH_TOKEN="$GH_TOKEN_PEZWARE" ;;
        esac
    fi
    # Never leak a token the call did not select into the child process. This
    # list is a denylist over the credentials file, so it needs an entry for
    # every secret added there — GHCR_TOKEN was added on 2026-08-04 and missed.
    unset GH_TOKEN_IDEN2 GH_TOKEN_PEZWARE GHCR_TOKEN LINODE_TOKEN TF_VAR_tailscale_auth_key
fi

# ── Say what actually went wrong, before gh says something false ─────────────
#
# With no token selected, gh prints:
#
#     To get started with GitHub CLI, please run: gh auth login
#
# On this box that advice is WRONG and following it is harmful: there is no
# stored credential by design — the token is injected per invocation, and
# ~/.config/gh stays empty even when gh works perfectly. An agent that trusts
# that message reaches for `gh auth login` or a PAT, and both are dead ends.
#
# This cost a real session on 2026-08-05. The agent was in ~/src/iden2, one level
# above the repo, concluded "gh isn't authenticated on this box", and stopped to
# ask the human — while `gh` two directories down worked fine. The skill covering
# this was present and current; it simply never fired, because nothing suggested
# a devbox quirk rather than an ordinary auth problem.
#
# So the correction goes where it cannot be missed: on stderr, in front of the
# misleading line, every time. A wrapper that knows why it has no token should
# not let the tool it wraps guess.
if [ -z "${GH_TOKEN:-}" ]; then
    case "${1:-}" in
        # Local-only invocations need no token; staying quiet keeps the warning
        # meaningful when it does appear.
        ''|--version|-v|--help|-h|help|completion|alias|config|extension) ;;
        *)
            if [ -z "$owner" ]; then
                cat >&2 <<'MSG'
gh-wrapper: no token selected — no --repo given and not inside a git repository.
  This wrapper picks a token from the repository's OWNER. Give it one, either way:
      gh <cmd> --repo iden2-com/<repo>      # works from anywhere
      cd ~/src/iden2/<repo> && gh <cmd>     # uses the origin remote
  Do NOT run `gh auth login`, and do NOT reach for a PAT: there is no stored
  credential on this box by design. An empty ~/.config/gh is correct here.
MSG
            else
                cat >&2 <<MSG
gh-wrapper: no token for owner "$owner" — only pezware and iden2-com are mapped.
  Check that ~/.config/0x58/credentials.env has a non-empty entry for it.
  Do NOT run \`gh auth login\`: this box stores no credential by design.
MSG
            fi
            ;;
    esac
fi

exec "$GH" "$@"
