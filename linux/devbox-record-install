#!/usr/bin/env bash
#
# PostToolUse hook: log install-shaped Bash commands to a ledger.
#
# Wired for the Bash tool in linux/claude-settings.json. Reads the hook payload
# on stdin and appends matching commands to ~/.local/state/0x58/installs.log,
# which bin/devbox-drift reconciles against linux/packages.txt.
#
# WHY THIS EXISTS
#
# An agent that installs a package to get unblocked is doing the right thing.
# The failure is that the install is invisible afterwards: it works, the task
# proceeds, and weeks later a rebuilt box hits the original problem again with
# no trace of what fixed it. A package list diff can find the package but not
# the reason, and the reason is the expensive part.
#
# So this records the command AND the session id at the moment it ran, while
# the transcript that explains why still exists. devbox-drift then reports any
# ledger entry that never made it into a declaration.
#
# DESIGN: THIS NEVER BLOCKS AND NEVER FAILS.
#
# It exits 0 unconditionally, including on malformed input, a missing python3,
# or an unwritable ledger. A hook that can break an agent's turn in exchange for
# bookkeeping is a bad trade — the drift check is the backstop, and it works
# from the package list alone even if every ledger write was lost.
#
# The payload schema is read defensively for the same reason: it looks for
# tool_input.command and falls back to a raw scan, so a schema change degrades
# this to a no-op instead of an error on every Bash call.
set -uo pipefail

LEDGER_DIR="$HOME/.local/state/0x58"
LEDGER="$LEDGER_DIR/installs.log"

payload="$(cat 2>/dev/null || true)"
[ -n "$payload" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

mkdir -p "$LEDGER_DIR" 2>/dev/null || exit 0

PAYLOAD="$payload" LEDGER="$LEDGER" python3 <<'PY' 2>/dev/null || true
import json, os, re, subprocess, time

raw = os.environ.get("PAYLOAD", "")
try:
    data = json.loads(raw)
except Exception:
    data = {}

cmd = ""
if isinstance(data, dict):
    ti = data.get("tool_input")
    if isinstance(ti, dict):
        cmd = ti.get("command") or ""
    if not cmd:
        # Schema drift fallback: any string field that looks like a shell line.
        for v in data.values():
            if isinstance(v, str) and len(v) < 4000 and " " in v:
                cmd = v
                break
if not cmd:
    raise SystemExit(0)

session = ""
if isinstance(data, dict):
    session = str(data.get("session_id") or data.get("sessionId") or "")[:8]

# Deliberately narrow. Broad matching would log every `go build` and bury the
# handful of lines that actually represent a durable change to the box.
#   - apt/dnf/apk install         : changes the system package set
#   - mise use/install            : changes the tool set on PATH
#   - npm/pnpm/yarn -g, pipx, pip : user-global installs that survive the task
#   - go install                  : drops a binary into ~/go/bin
PATTERNS = [
    r"\bapt(-get)?\s+(-\S+\s+)*install\b",
    r"\b(dnf|yum|apk)\s+(add|install)\b",
    r"\bmise\s+(use|install)\b",
    r"\b(npm|pnpm|yarn)\s+(i|install|add)\s+(-\S+\s+)*(-g|--global)\b",
    r"\bpipx\s+install\b",
    r"\bpip3?\s+install\b",
    r"\bgo\s+install\b",
    r"\bcargo\s+install\b",
]


def strip_literals(s):
    """Blank out quoted strings and comments.

    Matching raw command text confuses TALKING ABOUT an install with DOING one.
    Both false entries in the ledger on 2026-08-09 were read-only greps of this
    very repo: an `echo "... or apt install ..."` banner, and a
    `grep -nE 'apt install|apt-get install' ...` pattern. Neither installed
    anything. A ledger that fires on discussion is one people learn to skip.

    Quotes become spaces rather than vanishing, so `a"x"b` cannot fuse into `ab`
    and invent a token that was never typed.
    """
    out, quote, i, n = [], None, 0, len(s)
    while i < n:
        c = s[i]
        if quote:
            if c == "\\" and quote == '"' and i + 1 < n:
                i += 2
                continue
            if c == quote:
                quote = None
            i += 1
            continue
        if c in ('"', "'"):
            quote, out = c, out + [" "]
            i += 1
            continue
        if c == "#" and (not out or out[-1] in " \t\n;&|("):
            while i < n and s[i] != "\n":
                i += 1
            continue
        out.append(c)
        i += 1
    return "".join(out)


effective = strip_literals(cmd)
if not any(re.search(p, effective) for p in PATTERNS):
    raise SystemExit(0)

# Skip the obvious no-ops so the ledger stays worth reading.
if re.search(r"--dry-run|--help|\s-h\b", effective):
    raise SystemExit(0)


def apt_packages(text):
    """Operands of an apt/dnf/apk install, i.e. what it claims to have added."""
    pkgs = []
    for m in re.finditer(
        r"\b(?:apt(?:-get)?|dnf|yum|apk)\s+(?:-\S+\s+)*(?:install|add)\b(.*)", text
    ):
        for tok in m.group(1).split():
            if tok.startswith("-"):
                continue
            if tok in (";", "&&", "||", "|", "&"):
                break
            if not re.match(r"^[A-Za-z0-9][A-Za-z0-9+._-]*$", tok):
                break
            pkgs.append(tok)
    return pkgs


def installed(pkg):
    try:
        r = subprocess.run(
            ["dpkg-query", "-W", "-f=${db:Status-Status}", pkg],
            capture_output=True, text=True, timeout=5,
        )
        return r.returncode == 0 and r.stdout.strip() == "installed"
    except Exception:
        # Cannot confirm is NOT the same as confirmed absent. Record and let the
        # human reconcile; a spurious entry is cheap, a lost one is not.
        return True


# CONFIRM BY EFFECT, not by text. This is a PostToolUse hook, so the command has
# already run: for system packages we can ask whether the operands are actually
# installed NOW instead of trusting that the line meant what it looked like.
# Only apt-family is confirmable this cheaply; mise/npm/pip/go/cargo keep the
# textual path above, now with literals stripped.
if re.search(r"\b(?:apt(?:-get)?|dnf|yum|apk)\s+(?:-\S+\s+)*(?:install|add)\b", effective):
    pkgs = apt_packages(effective)
    if pkgs and not any(installed(p) for p in pkgs):
        raise SystemExit(0)

line = "\t".join([
    time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    session or "-",
    " ".join(cmd.split())[:400],
])
try:
    with open(os.environ["LEDGER"], "a") as fh:
        fh.write(line + "\n")
except Exception:
    pass
PY

exit 0
