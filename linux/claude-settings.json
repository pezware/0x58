{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:pkg.go.dev)"
    ],
    "additionalDirectories": [
      "~/src"
    ]
  },
  "sandbox": {
    "enabled": true,
    "enabledPlatforms": [
      "linux"
    ],
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git",
      "gh"
    ],
    "credentials": {
      "files": [
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/.codex/auth.json",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "LINODE_TOKEN",
          "mode": "deny"
        },
        {
          "name": "TF_VAR_tailscale_auth_key",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.gnupg",
        "~/.config/gcloud",
        "~/.kube",
        "~/.aws",
        "~/.config/tailscale",
        "/var/lib/tailscale",
        "/etc/0x58-node.env"
      ],
      "allowWrite": [
        "~",
        "/tmp"
      ],
      "denyWrite": [
        "~/.claude/settings.json",
        "~/.claude/.credentials.json",
        "~/.codex/auth.json",
        "~/.codex/config.toml",
        "~/.ssh",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/.config/gh",
        "~/.config/git/allowed_signers",
        "~/.config/0x58"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowAllUnixSockets": true,
      "allowUnixSockets": [
        "/tmp/codex-broker/0x58.sock",
        "/tmp/codex-broker/go-monorepo.sock",
        "/tmp/codex-broker/platform-apis.sock"
      ],
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "storage.googleapis.com",
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "*.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "releases.hashicorp.com",
        "registry.terraform.io",
        "deb.debian.org",
        "security.debian.org",
        "mise.jdx.dev",
        "crates.io",
        "static.crates.io",
        "chatgpt.com",
        "api.openai.com"
      ]
    }
  }
}
