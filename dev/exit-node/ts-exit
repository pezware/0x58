#!/usr/bin/env bash
# Top-level dispatcher: ts-exit --cloud=gcp|linode <command> [args...]
# Defaults to linode (the currently-active cloud — see ./README.md).
set -euo pipefail

CLOUD="linode"
case "${1:-}" in
  --cloud=*) CLOUD="${1#--cloud=}"; shift ;;
  --cloud)   CLOUD="${2:-}"; shift 2 ;;
esac

DIR="$(cd "$(dirname "$0")" && pwd)/${CLOUD}"
[ -x "${DIR}/ts-exit" ] || {
  echo "error: unknown cloud '${CLOUD}' (no executable at ${DIR}/ts-exit)" >&2
  echo "       valid: gcp | linode" >&2
  exit 1
}

exec "${DIR}/ts-exit" "$@"
