#!/usr/bin/env bash
# shellcheck disable=SC2088  # tildes below are in human-readable check LABELS,
# not paths this shell resolves; real paths are $HOME-based or expanded remotely.
#
# Post-rebuild smoke test for the devbox.
#
#   ./dev/nodes/devbox-smoketest
#
# Run it after every `ts-node devbox apply`. A rebuild restores the instance, not
# the workflow — the 2026-08-03 rehearsal came back with source, dotfiles, podman
# and the gh wrapper all intact, and still could not sign a commit as the right
# GitHub account. Nothing looked broken; every file was present.
#
# So this checks by DOING, not by inspecting. It makes a real signed commit, asks
# for a real token, opens a real socket. Config that exists and config that works
# are different claims, and only one of them is worth knowing.
#
# It runs from the Mac because half the loop lives here: the Keychain escrow the
# box is restored FROM, and the MagicDNS name everything addresses it BY.
#
# Every check has a negative control where one is possible. A test that only
# proves the happy path cannot tell "working" from "absent" — the sandbox probe
# is the clearest case, since a blocked socket and a missing one look identical
# from inside.
set -uo pipefail

HOST="${DEVBOX_HOST:-pezware-devbox}"
REMOTE_USER="${DEVBOX_USER:-arbeitandy}"
REMOTE="${REMOTE_USER}@${HOST}"

PASS=0; FAIL=0; SKIP=0
FAILED_NAMES=()

green() { printf '\033[32m%s\033[0m' "$1"; }
red()   { printf '\033[31m%s\033[0m' "$1"; }
amber() { printf '\033[33m%s\033[0m' "$1"; }

# ok <name> <detail>  /  no <name> <detail>  — one line per check, detail always
# printed. A bare PASS/FAIL teaches nothing when it later regresses.
ok()   { PASS=$((PASS+1)); printf '  %s %-42s %s\n' "$(green ' ok ')" "$1" "${2:-}"; }
no()   { FAIL=$((FAIL+1)); FAILED_NAMES+=("$1"); printf '  %s %-42s %s\n' "$(red 'FAIL')" "$1" "${2:-}"; }
skip() { SKIP=$((SKIP+1)); printf '  %s %-42s %s\n' "$(amber 'skip')" "$1" "${2:-}"; }

section() { printf '\n\033[1m%s\033[0m\n' "$1"; }

# Always a LOGIN shell. `ssh host cmd` runs non-interactive and non-login, so it
# never sources bashrc — mise's shims and ~/.local/bin are absent, and the box
# reports `gh: command not found` while gh is installed and working. That is a
# false alarm about the thing being tested, which is the worst kind for a smoke
# test to raise. printf %q keeps the remote quoting honest.
remote() { ssh -o ConnectTimeout=15 -o BatchMode=yes "$REMOTE" "bash -lc $(printf '%q' "$*")" 2>/dev/null; }

# ── reachability ────────────────────────────────────────────────────────────
section "Reachability"

# The name matters as much as the box. Tailscale will not reuse a hostname while
# a stale record holds it, so a rebuild whose old node was not deleted silently
# joins as pezware-devbox-1 — and every `ssh devbox`, mosh and backup path that
# addresses it by name breaks while the box itself is perfectly healthy.
if remote true; then
    ok "ssh $HOST" "reachable by MagicDNS name"
else
    no "ssh $HOST" "unreachable — stale tailnet record holding the name? check for ${HOST}-1"
    printf '\n%s\n' "$(red 'Cannot reach the box; remaining checks would all fail for the same reason.')"
    exit 1
fi

TS_CLI=$(command -v tailscale || echo /Applications/Tailscale.app/Contents/MacOS/Tailscale)
if [ -x "$TS_CLI" ]; then
    dupes=$("$TS_CLI" status 2>/dev/null | grep -cE "[[:space:]]${HOST}-[0-9]+[[:space:]]" || true)
    [ "${dupes:-0}" -eq 0 ] \
        && ok "no suffixed tailnet duplicate" "nothing named ${HOST}-N" \
        || no "no suffixed tailnet duplicate" "found ${HOST}-N — delete the stale node"
else
    skip "no suffixed tailnet duplicate" "tailscale CLI not found"
fi

# ── the data that must outlive the instance ─────────────────────────────────
section "Persistence"

# Source lives on a detachable volume precisely so the instance can be cattle.
# If this is on the root disk, a rebuild silently ate everything not pushed.
mnt=$(remote 'findmnt -no SOURCE --target "$HOME/src" 2>/dev/null')
case "$mnt" in
    /dev/sd[b-z]*) ok "~/src on its own volume" "$mnt" ;;
    "")            no "~/src on its own volume" "cannot determine mount" ;;
    *)             no "~/src on its own volume" "$mnt — looks like the ROOT disk, not the volume" ;;
esac

repos=$(remote 'ls ~/src 2>/dev/null | grep -vc "^lost+found$"')
[ "${repos:-0}" -gt 0 ] \
    && ok "source trees present" "$repos tree(s) under ~/src" \
    || no "source trees present" "~/src is empty"

# Uncommitted work is the one class no rebuild can recover. Report it as a
# warning here so it is seen BEFORE the next apply, not after.
dirty=$(remote 'n=0; while IFS= read -r g; do r=$(dirname "$g"); c=$(git -C "$r" status --porcelain 2>/dev/null | wc -l); n=$((n+c)); done < <(find "$HOME/src" -maxdepth 4 -type d -name .git 2>/dev/null); echo "$n"')
[ "${dirty:-0}" -eq 0 ] \
    && ok "no uncommitted work at risk" "working trees clean" \
    || skip "no uncommitted work at risk" "$dirty modified file(s) — snapshot before the next apply"

# ── restored secrets ────────────────────────────────────────────────────────
section "Restored secrets"

for k in devbox_agent devbox_agent_personal; do
    live=$(remote "ssh-keygen -lf ~/.ssh/$k.pub 2>/dev/null | awk '{print \$2}'")
    esc=$(security find-generic-password -s "devbox-sshkey-$k" -a "$USER" -w 2>/dev/null \
          | base64 -d 2>/dev/null | ssh-keygen -y -f /dev/stdin 2>/dev/null \
          | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')
    if [ -z "$live" ]; then
        no "ssh key $k" "absent — run: ./dev/nodes/devbox-keys restore"
    elif [ -n "$esc" ] && [ "$live" != "$esc" ]; then
        no "ssh key $k" "on-box key DIFFERS from Keychain escrow"
    else
        ok "ssh key $k" "$live"
    fi
done

perm=$(remote 'stat -c %a ~/.ssh/devbox_agent 2>/dev/null')
[ "$perm" = "600" ] \
    && ok "private key permissions" "0600" \
    || no "private key permissions" "${perm:-absent} — ssh refuses anything looser"

# Asserted one NAME at a time, not as a count. A count is the wrong shape twice
# over: it passes while the single entry that mattered is the one missing, and it
# fails for the harmless case of a secret being ADDED — which is exactly what
# happened when GHCR_TOKEN landed and turned this red on a healthy box. The names
# are the contract; the number is an accident of how many we have today.
cperm=$(remote 'stat -c %a ~/.config/0x58/credentials.env 2>/dev/null')
[ "$cperm" = "600" ] \
    && ok "credentials.env permissions" "0600" \
    || no "credentials.env permissions" "${cperm:-absent} — readable beyond you"

for _v in GH_TOKEN_PEZWARE GH_TOKEN_IDEN2 LINODE_TOKEN TF_VAR_tailscale_auth_key GHCR_TOKEN; do
    if remote "grep -qE '^$_v=.+' ~/.config/0x58/credentials.env 2>/dev/null"; then
        ok "credentials.env: $_v" "present and non-empty"
    else
        no "credentials.env: $_v" "missing or empty — re-place from Keychain (dev/nodes/README.md step 5)"
    fi
done
unset _v

# ── signing: the check the rehearsal was worth running for ──────────────────
section "Commit signing"

# The rebuilt box restored the MAC's gitconfig, so user.signingkey pointed at the
# Secure Enclave key — a key this box does not hold, registered to a DIFFERENT
# GitHub account. Signing would have failed, or worse, succeeded as the wrong
# person. Comparing the configured key to the one on disk is the cheap check.
# Two valid forms, and which one is used is not cosmetic. `key::<pubkey>` names a
# key held by an AGENT — correct on the Mac, where Secretive keeps the key in the
# Secure Enclave and there is no file to point at. The devbox is the mirror image:
# a key on disk and no agent, so it must name a PATH. Copying the Mac's gitconfig
# here fails with "Couldn't find key in agent?" whichever key it names.
raw=$(remote 'git config --get user.signingkey')
case "$raw" in
    key::*) cfg=$(remote "git config --get user.signingkey | sed 's/^key:://' | ssh-keygen -lf - 2>/dev/null | awk '{print \$2}'")
            form="key:: (needs an agent)" ;;
    "")     cfg=""; form="unset" ;;
    *)      cfg=$(remote "ssh-keygen -lf \"\$(git config --get user.signingkey)\" 2>/dev/null | awk '{print \$2}'")
            form="path (signs without an agent)" ;;
esac
# Compared against EVERY key on the box, not against devbox_agent by name. This
# named that key literally until 2026-08-04 and so went red the moment the default
# identity correctly moved to devbox_agent_personal — reporting a healthy box as
# broken, which is the failure mode that trains you to ignore a red line. Which
# key is right for which identity is a separate question, asserted against GitHub
# further down; this one only asks whether the box can sign with it at all.
own=$(remote 'for f in ~/.ssh/*.pub; do ssh-keygen -lf "$f" 2>/dev/null | awk "{print \$2}"; done')
if [ -n "$cfg" ] && printf '%s\n' "$own" | grep -qxF "$cfg"; then
    ok "signingkey is a key this box holds" "$form, $(remote "basename \"\$(git config --get user.signingkey)\"" 2>/dev/null)"
else
    no "signingkey is a key this box holds" "form=$form configured=${cfg:-unresolvable} — no key in ~/.ssh matches"
fi

# Local verification is a separate mechanism from GitHub's. sign-push refuses to
# push unless `git log %G?` reports G, and that depends on allowed_signers — so a
# correct key with a stale signers file still blocks the workflow.
#
# Checks the CONFIGURED key, not a hardcoded one. This named devbox_agent.pub
# until 2026-08-04, so it went on passing after the global identity moved to the
# personal key — it was asserting the presence of a key nothing was signing with.
if remote 'grep -qF "$(awk "{print \$2}" "$(git config --get user.signingkey)".pub)" ~/.config/git/allowed_signers 2>/dev/null'; then
    ok "configured key in allowed_signers" "local verification will resolve"
else
    no "configured key in allowed_signers" "sign-push will report unsigned even after signing"
fi

# End to end: sign something and verify it. Throwaway repo, so no real history is
# touched and no network is needed.
sig=$(remote 'd=$(mktemp -d); cd "$d" || exit 1
  git init -q . 2>/dev/null
  git commit -q --allow-empty -S -m smoketest 2>/dev/null
  git log --format=%G? -1 2>/dev/null
  cd /; rm -rf "$d"')
case "$sig" in
    G) ok "signs and verifies a real commit" "git reports G (good signature)" ;;
    "") no "signs and verifies a real commit" "signing failed — no agent and no on-disk key?" ;;
    *) no "signs and verifies a real commit" "git reports '$sig', expected G" ;;
esac

# ...and again where the conditional include applies. Signing in /tmp proves only
# that the GLOBAL config works; `includeIf gitdir:~/src/iden2/` overrides it there,
# and an override that reintroduces the Mac's key:: form fails ONLY in iden2 repos.
# That gap shipped once and was found by an agent doing real work, not by this test.
sig2=$(remote 'd=$HOME/src/iden2/.smoketest-$$; mkdir -p "$d"; cd "$d" || exit 1
  git init -q . 2>/dev/null
  git commit -q --allow-empty -S -m smoketest 2>/dev/null
  git log --format=%G? -1 2>/dev/null
  cd /; rm -rf "$d"')
case "$sig2" in
    G)  ok "signs under ~/src/iden2 too" "the includeIf work config resolves" ;;
    "") no "signs under ~/src/iden2 too" "signing failed only here — the work include likely overrides signingkey with key::" ;;
    *)  no "signs under ~/src/iden2 too" "git reports '$sig2', expected G" ;;
esac

# Everything above is LOCAL, and on 2026-08-04 every one of those checks passed
# while GitHub rejected the signature on a real PR with `unknown_key`. The box has
# two keys, one per account, and the global identity had been paired with the WORK
# key; allowed_signers cross-mapped it, so %G? reported G for a key the committing
# account does not own. Local agreement was configured, not earned.
#
# GitHub resolves email -> account -> THAT account's signing keys. Assert that
# pairing, since it is the only one that decides whether a commit lands verified.
# The endpoint is public, so this needs no token and no push.
# $2 is expanded on the BOX, so it must be $HOME-based and double-quoted through.
# A '~' here silently produces "not a path form" and the check skips green —
# which is how this assertion first shipped, and exactly the failure it exists to
# catch. A skipped check is not a passing one; read the amber.
signing_pair() {   # $1 label   $2 dir on the box   $3 github login that owns the email
    local kp pub keys em
    em=$(remote "cd \"$2\" 2>/dev/null && git config --get user.email")
    kp=$(remote "cd \"$2\" 2>/dev/null && git config --get user.signingkey")
    case "$kp" in
        "")      no   "$1 signing key belongs to $3" "no signingkey resolved at $2 — is the repo there?" ; return ;;
        key::*)  skip "$1 signing key belongs to $3" "key:: form — the agent holds it, nothing on disk to resolve" ; return ;;
    esac
    pub=$(remote "awk '{print \$2}' \"$kp.pub\" 2>/dev/null")
    [[ -n "$pub" ]] || { no "$1 signing key belongs to $3" "cannot read $kp.pub on the box" ; return ; }
    keys=$(curl -fsS --max-time 15 "https://api.github.com/users/$3/ssh_signing_keys" 2>/dev/null)
    [[ -n "$keys" ]] || { skip "$1 signing key belongs to $3" "GitHub unreachable — pairing unchecked" ; return ; }
    if grep -qF "$pub" <<<"$keys"; then
        ok "$1 signing key belongs to $3" "$em signs with a key $3 owns"
    else
        no "$1 signing key belongs to $3" "$em signs with a key $3 does NOT own — pushes succeed and land UNVERIFIED"
    fi
}
signing_pair "pezware" '$HOME/src/public/0x58'       achtungandy
signing_pair "iden2"   '$HOME/src/iden2/go-monorepo' arbeitandy

who=$(remote 'ssh -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes -i ~/.ssh/devbox_agent -T git@github.com 2>&1 | head -1')
case "$who" in
    *"Hi arbeitandy"*) ok "github ssh auth" "authenticates as arbeitandy" ;;
    *) no "github ssh auth" "${who:-no response}" ;;
esac

# ── tokens ──────────────────────────────────────────────────────────────────
section "GitHub tokens"

# Positive AND negative. Seeing the right token work does not prove selection —
# only forcing the wrong one and watching it fail does.
pez=$(remote 'cd ~/src/public/0x58 && gh repo view --json name --jq .name 2>&1 | head -1')
[ "$pez" = "0x58" ] \
    && ok "pezware repo via wrapper" "resolved pezware/0x58" \
    || no "pezware repo via wrapper" "$pez"

if remote 'test -d ~/src/iden2/go-monorepo'; then
    id2=$(remote 'cd ~/src/iden2/go-monorepo && gh repo view --json name --jq .name 2>&1 | head -1')
    [ "$id2" = "go-monorepo" ] \
        && ok "iden2 repo via wrapper" "resolved iden2-com/go-monorepo" \
        || no "iden2 repo via wrapper" "$id2"

    wrong=$(remote 'cd ~/src/iden2/go-monorepo && GH_TOKEN="$(grep ^GH_TOKEN_PEZWARE= ~/.config/0x58/credentials.env | cut -d= -f2-)" \
            command gh repo view --json name --jq .name 2>&1 | head -1')
    case "$wrong" in
        *"Could not resolve"*|*"not found"*|*404*) ok "wrong token is rejected" "pezware token cannot see iden2 repo" ;;
        go-monorepo) no "wrong token is rejected" "pezware token READ an iden2 repo — scoping is wrong" ;;
        *) skip "wrong token is rejected" "inconclusive: $wrong" ;;
    esac
else
    skip "iden2 repo via wrapper" "go-monorepo not cloned"
fi

# Contents:Read is what forces every push through the signing key. If a token
# ever gains write, the whole gate is silently gone.
push=$(remote 'cd ~/src/public/0x58 && GIT_TERMINAL_PROMPT=0 \
       git push "https://x-access-token:$(grep ^GH_TOKEN_PEZWARE= ~/.config/0x58/credentials.env | cut -d= -f2-)@github.com/pezware/0x58.git" \
       HEAD:refs/heads/smoketest-must-fail 2>&1 | grep -cE "denied|403"')
[ "${push:-0}" -gt 0 ] \
    && ok "token cannot push (Contents:Read)" "HTTPS push refused, as designed" \
    || no "token cannot push (Contents:Read)" "a token GAINED write — push no longer requires the signing key"

# ── sandbox boundary ────────────────────────────────────────────────────────
section "Agent sandbox"

for b in bwrap socat; do
    remote "command -v $b >/dev/null" \
        && ok "$b present" "sandbox dependency" \
        || no "$b present" "failIfUnavailable makes this a hard startup failure"
done

remote 'python3 -m json.tool ~/.claude/settings.json >/dev/null 2>&1' \
    && ok "claude settings parse" "valid JSON" \
    || no "claude settings parse" "malformed — sandbox config may not apply"

# This assertion INVERTED on 2026-08-04. It used to demand that
# allowAllUnixSockets be absent; enabling it is now deliberate, so that agents can
# run the container-backed test tiers in-session. A silent revert would strand the
# integration and e2e tiers again, which is why the switch is asserted present
# rather than merely tolerated.
remote 'grep -q "allowAllUnixSockets" ~/.claude/settings.json 2>/dev/null' \
    && ok "unix sockets reachable in-session" "allowAllUnixSockets on — container tiers can run" \
    || no "unix sockets reachable in-session" "allowAllUnixSockets absent — integration/e2e tiers cannot run"

# With AF_UNIX open, these denials are the whole boundary around the two
# subscription refresh tokens — nothing else stands between an agent and them.
# Both must sit in sandbox.credentials.files with mode deny; denyWrite is not
# enough, and ~/.codex/auth.json was listed ONLY under denyWrite until 2026-08-04
# while the docs claimed it was denied outright.
#
# Unlike its neighbours this check inspects rather than does. The honest in-session
# control needs a live Claude session, and an agent may decline to run a
# credential probe at all — correct of it, but a smoke test must not depend on a
# judgement call landing one way. Run the probe in linux/sandbox.md by hand.
for cred in claude/.credentials.json codex/auth.json; do
    remote "grep -A1 -e path.*${cred##*/} ~/.claude/settings.json | grep -q mode.*deny" \
        && ok "~/.${cred%%/*}/${cred#*/} denied to agents" "in credentials.files as deny" \
        || no "~/.${cred%%/*}/${cred#*/} denied to agents" "NOT denied — an agent can read the refresh token"
done

# ── login-execution surfaces ────────────────────────────────────────────────
# Added 2026-08-04 after a probe found allowWrite was "~", not "~/src" as
# sandbox.md claimed. That gap did not need privilege escalation to matter: an
# agent cannot sudo (no_new_privs, measured in-session), but it could write
# ~/.bashrc and wait for the human's next login — unsandboxed, NOPASSWD:ALL.
#
# Asserted one path at a time rather than as a count, because a count passes
# happily while the single entry that mattered is the one removed.
# ~/.claude/settings.local.json is called out specifically: settings.json was
# already denied while the .local override was not, and planting agent hooks is
# precisely how the 2026-08-04 npm worm persisted.
for p in '~/.bashrc' '~/.bash_profile' '~/.profile' '~/.config/systemd' \
         '~/.local/bin' '~/.claude/settings.local.json' '~/.gitconfig'; do
    remote "python3 -c \"
import json, os, sys
d = json.load(open(os.path.expanduser('~/.claude/settings.json')))
w = d.get('sandbox', {}).get('filesystem', {}).get('denyWrite', [])
sys.exit(0 if '$p' in w else 1)\"" \
        && ok "$p write-denied" "cannot persist into a privileged login" \
        || no "$p write-denied" "an agent can plant code that runs in YOUR next session"
done

# ── supply-chain cooldown ───────────────────────────────────────────────────
# A publish-then-yank attack is caught by waiting, not by scanning. Both gates
# below fail OPEN when absent — an install just proceeds — so nothing surfaces
# them except a check like this one.
section "Supply-chain cooldown"

# pnpm: minutes. 10080 = 7 days. The floor matters as much as its presence,
# because `minimumReleaseAge: 7` looks configured and buys seven minutes.
remote 'test "$(~/.local/share/mise/shims/pnpm config get minimumReleaseAge 2>/dev/null)" -ge 10080' \
    && ok "pnpm cooldown >= 7 days" "~/.config/pnpm/config.yaml — readable by agents" \
    || no "pnpm cooldown >= 7 days" "unset or too low — fresh malicious publishes are installable"

# pnpm 11 ships a 1440 default that is NON-strict: it degrades rather than fails.
remote 'test "$(~/.local/share/mise/shims/pnpm config get minimumReleaseAgeStrict 2>/dev/null)" = true' \
    && ok "pnpm cooldown is strict" "an unsatisfiable floor fails loudly" \
    || no "pnpm cooldown is strict" "non-strict — pnpm may resolve something younger instead"

# npm needs >= 11.10 for the key to do anything. Below that it is stored,
# echoed back by `npm config get`, and ignored — so assert npm's own config
# list KNOWS the key rather than that the file contains it.
remote '~/.local/share/mise/shims/npm config ls -l 2>/dev/null | grep -q "^; min-release-age\|^min-release-age"' \
    && ok "npm knows min-release-age" "npm >= 11.10; the .npmrc line is enforced" \
    || no "npm knows min-release-age" "npm too old — ~/.npmrc says 7 days and nothing honours it"

# Install scripts are the execution vector: a malicious version does not need to
# be imported, only installed. npm runs them by default; pnpm has not since v10.
remote 'test "$(~/.local/share/mise/shims/npm config get ignore-scripts)" = true' \
    && ok "npm install scripts disabled" "ignore-scripts=true" \
    || no "npm install scripts disabled" "dependency postinstall runs on install"

# pnpm's protection is default-deny plus an allowlist. The failure mode is not
# an unset flag, it is someone reaching for the documented override.
remote 'test "$(~/.local/share/mise/shims/pnpm config get dangerouslyAllowAllBuilds)" != true' \
    && ok "pnpm builds not blanket-allowed" "default-deny intact; allowlist via onlyBuiltDependencies" \
    || no "pnpm builds not blanket-allowed" "dangerouslyAllowAllBuilds=true — every dependency build runs"

# ── containers ──────────────────────────────────────────────────────────────
section "Containers"

if remote 'command -v podman >/dev/null'; then
    remote 'systemctl --user is-active podman.socket >/dev/null 2>&1' \
        && ok "podman.socket active" "testcontainers can reach the API" \
        || no "podman.socket active" "systemctl --user enable --now podman.socket"

    remote 'loginctl show-user "$USER" -p Linger --value 2>/dev/null | grep -q yes' \
        && ok "lingering enabled" "socket survives logout" \
        || no "lingering enabled" "socket dies when you detach — tests fail only when unattended"

    # Rootless podman cannot bind below 1024, which is what actually blocked the
    # compose tier — Caddy wants 80 and 443. Misfiled as a memory problem for a
    # while; it never was one. Devbox-only on purpose: the k8s node is where
    # hostile code is meant to run, and low ports there means port 53 there.
    remote '[ "$(cat /proc/sys/net/ipv4/ip_unprivileged_port_start)" = "0" ]' \
        && ok "unprivileged low ports" "rootless containers can bind 80/443" \
        || no "unprivileged low ports" "compose tier blocked — Caddy cannot bind 80/443"

    # Absence is not fatal, just slow: every cluster command falls back to
    # apt-installing its tools again, measured at 12.3s per container start
    # against 0.5s with the image. Warn rather than fail.
    if remote 'podman image exists localhost/0x58-toolbox:latest'; then
        ok "toolbox image baked" "cluster work starts in ~0.5s, not ~12s"
    else
        skip "toolbox image baked" "run dev/nodes/toolbox/build — each container start costs ~12s without it"
    fi
else
    skip "podman.socket active" "podman not installed"
fi

# ── toolchain ───────────────────────────────────────────────────────────────
section "Toolchain"

# mise trust state lives on the root disk, so a rebuild loses it — and mise
# reports an untrusted config as "error parsing config file", which reads like
# broken TOML. It breaks EVERY mise tool in that repo, not one.
for r in src/public/0x58 src/iden2/go-monorepo; do
    if remote "test -e ~/$r/.mise.toml"; then
        out=$(remote "cd ~/$r && mise ls --current 2>&1 | head -2")
        case "$out" in
            *"error parsing config"*|*"not trusted"*) no "mise trusted in $(basename "$r")" "run: mise trust ~/$r/.mise.toml" ;;
            *) ok "mise trusted in $(basename "$r")" "config loads" ;;
        esac
    fi
done

for t in git gh mise tmux podman; do
    remote "command -v $t >/dev/null" \
        && ok "$t on PATH" "$(remote "command -v $t")" \
        || no "$t on PATH" "missing"
done

# `gh` must resolve to the WRAPPER even once mise is on PATH. Two different gh
# binaries exist: ~/.local/bin/gh selects a fine-grained PAT by the repo's owner,
# while ~/.local/share/mise/shims/gh is raw gh with no credential and answers
# "please run gh auth login" — an error that reads like a broken install rather
# than a shadowed binary, and cost a session real time on 2026-08-04.
#
# Checked in a LOGIN INTERACTIVE shell on purpose: that is the only kind that
# runs `mise activate`, so it is the only place the ordering can regress. bashrc
# re-prepends ~/.local/bin after activation specifically to win this race.
gh_resolved=$(remote 'bash -lic "command -v gh" 2>/dev/null' | tr -d '\r')
case "$gh_resolved" in
    */.local/bin/gh) ok "gh resolves to the wrapper" "mise on PATH does not shadow it" ;;
    */shims/gh)      no "gh resolves to the wrapper" "got the mise shim — raw gh, no token" ;;
    "")              no "gh resolves to the wrapper" "gh not found in a login shell at all" ;;
    *)               no "gh resolves to the wrapper" "unexpected: $gh_resolved" ;;
esac

# Look for the shim as well as the command. bashrc returns early in
# non-interactive shells -- the usual `case $- in *i*)` guard -- so neither the
# codex wrapper function nor `mise activate` exists here, and codex reports as
# missing while being installed and runnable. mise activate rewires PATH from an
# interactive prompt hook; the shim is the thing that is always on disk.
for t in claude codex; do
    if remote "command -v $t >/dev/null 2>&1 || test -x ~/.local/share/mise/shims/$t || test -x ~/.local/bin/$t"; then
        ok "$t available" "$(remote "$t --version 2>/dev/null || ~/.local/share/mise/shims/$t --version 2>/dev/null" | head -1)"
    else
        skip "$t available" "not installed — mise install may still be running, then: $t login"
    fi
done

# ── verdict ─────────────────────────────────────────────────────────────────
printf '\n\033[1mResult\033[0m  %s passed, %s failed, %s skipped\n' \
    "$(green "$PASS")" "$( [ "$FAIL" -gt 0 ] && red "$FAIL" || echo 0 )" "$SKIP"

if [ "$FAIL" -gt 0 ]; then
    printf '\nFailed:\n'
    printf '  - %s\n' "${FAILED_NAMES[@]}"
    exit 1
fi
printf '\nThe full loop works: signed commits as the right identity, scoped tokens\nthat cannot push, an intact sandbox boundary.\n'
