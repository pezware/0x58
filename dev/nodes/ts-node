#!/usr/bin/env bash
#
# Tailscale node orchestrator.  ./ts-node <role> <command>
#
#   roles     devbox   Linode 4GB, always on — repos, agents, kubectl
#             k8s      Linode 8GB, on demand — docker + kind, disposable
#             minimal  Nanode 1GB — exit node only, the fall-back tier
#
#   commands  apply destroy plan | start stop resize status | ssh ip
#             sync-bootstrap — reinstall the boot scripts without a rebuild
#
# Secrets come from the macOS Keychain into the environment for the duration of
# this process. Same contract as dev/exit-node/linode/ts-exit, which this
# generalises. Be precise about what that does and does not buy:
#
#   LINODE_TOKEN  never a Terraform variable, so it cannot reach tfstate.
#   auth key      DOES reach tfstate and cloud-init's /var/lib/cloud cache,
#                 because it is rendered into instance user_data. `sensitive`
#                 only masks CLI output. Mitigate by preferring SINGLE-USE keys
#                 (spent at first join, so the copy at rest is worthless) and by
#                 keeping expiry short. tfstate is gitignored but is NOT secret-free.
#
# NOTE: dev/exit-node/ is deliberately left alone. It holds live state for the
# currently-active pezware-cuatro; `minimal` here is its successor for NEW
# builds, not a migration of the existing one.
set -euo pipefail

cd "$(dirname "$0")"

usage() {
    # basename, not "$0": we already cd'd to the script's own directory above, so
    # a relative "$0" like dev/nodes/ts-node no longer resolves from here — which
    # is the invocation the README uses everywhere.
    sed -n '3,10p' "$(basename "$0")" | sed 's/^# \{0,1\}//'
    exit "${1:-1}"
}

ROLE="${1:-}"; shift || true
CMD="${1:-}";  shift || true

[ -n "$ROLE" ] && [ -n "$CMD" ] || usage 1

ROLE_DIR="roles/$ROLE"
[ -d "$ROLE_DIR" ] || {
    echo "error: unknown role '$ROLE'" >&2
    echo "       valid: $(find roles -maxdepth 1 -mindepth 1 -type d -exec basename {} \; | sort | tr '\n' ' ')" >&2
    exit 1
}

export TF_VAR_tailscale_auth_key

# ── The k8s role runs from the DEVBOX, not the Mac ──────────────────────────
# Its state lives there so the node can be created and destroyed from a phone.
# Running it from the Mac would build a SECOND, independent state that knows
# nothing about a node the devbox already made -- terraform would then cheerfully
# create a duplicate and neither state could clean the other up. Refuse rather
# than diverge; divergence is silent and expensive, this is neither.
if [ "$ROLE" = "k8s" ] && [ "$(uname -s)" = "Darwin" ] && [ -z "${TS_NODE_ALLOW_MAC_K8S:-}" ]; then
    echo "error: k8s state lives on the devbox — run this there:" >&2
    echo "         ssh devbox '~/src/public/0x58/dev/nodes/ts-node k8s $CMD'" >&2
    echo "       (override with TS_NODE_ALLOW_MAC_K8S=1 only if you know why)" >&2
    exit 1
fi

# ── Secrets: environment, then a local file, then the macOS Keychain ────────
# The first two are what let fleet ops run somewhere other than the Mac. The
# Keychain remains the source of truth where it exists.
CREDS_FILE="${TS_NODE_CREDS:-$HOME/.config/0x58/credentials.env}"
if [ -r "$CREDS_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$CREDS_FILE"
    set +a
fi

keychain_get() {
    command -v security >/dev/null 2>&1 || return 1
    security find-generic-password -s "$1" -a "$USER" -w 2>/dev/null
}

# Loaded only by the commands that actually talk to Linode, so `ssh` and `ip`
# never carry the token in their environment at all.
needs_linode_token() {
    if [ -z "${LINODE_TOKEN:-}" ]; then
        LINODE_TOKEN=$(keychain_get linode-pat) || {
            echo "error: no Linode token." >&2
            echo "       set LINODE_TOKEN, or put it in $CREDS_FILE," >&2
            echo "       or add keychain item 'linode-pat' (see dev/exit-node/linode/README.md)" >&2
            exit 1
        }
    fi
    export LINODE_TOKEN
}

# Per-role auth keys, because a Tailscale key grants ALL of its tags to the node
# it registers — one shared multi-tag key would make every box wear every tag
# and defeat the ACL separation.
ts_keychain_item() {
    case "$1" in
        minimal) echo "tailscale-exit-authkey" ;;   # reuse the existing item
        # The waltid build box registers as tag:k8s and so uses the k8s key.
        # Both are disposable compute that holds no credentials, and reusing the
        # tag is what lets the devbox reach it under the ACL rules that already
        # exist. A tag:waltid would need a minted key and a policy edit in the
        # browser before the agent could reach anything.
        waltid)  echo "tailscale-k8s-authkey" ;;
        *)       echo "tailscale-$1-authkey" ;;
    esac
}

needs_auth_key() {
    local item; item=$(ts_keychain_item "$ROLE")
    [ -z "${TF_VAR_tailscale_auth_key:-}" ] || return 0
    TF_VAR_tailscale_auth_key=$(keychain_get "$item") || {
        echo "error: keychain item '$item' not found." >&2
        echo "       Generate a reusable + pre-approved key tagged tag:$ROLE at" >&2
        echo "       https://login.tailscale.com/admin/settings/keys then:" >&2
        echo "         security add-generic-password -U -s $item -a \"\$USER\" -w" >&2
        exit 1
    }
}

# ── Resize safety policy ────────────────────────────────────────────────────
# A downsize is REJECTED by Linode unless the disks already fit the smaller
# plan, and there is no automatic way back: Cloud Manager only offers Auto
# Resize Disk when "the new plan provides more storage space than the current
# plan", and the Terraform provider is blunt -- "This is an irreversible action
# as Linode disks cannot be automatically downsized."
#
# So this always sends allow_auto_disk_resize=false. Verified on pezware-cuatro
# 2026-08-11: resized nanode -> g6-standard-1 and the plan allotment doubled to
# 51200 MB while the actual disk stayed at 25088 MB, which is exactly what let
# the trip back down be accepted.
#
# resize_guard runs BEFORE the API call, so a bad request fails here with a
# useful message rather than as a failed job in the Linode events feed. All
# three checks refuse rather than warn: every one of them ends in a reboot you
# did not want, and a reboot on this fleet costs real work -- agent sessions in
# tmux, a kind cluster, container state that nothing restarts automatically.
resize_guard() {
    local id="$1" target="$2"

    # Root-disk allocation in MB (the sum that must fit the target plan), and
    # the target plan's storage allotment. Both straight from the API.
    local disk_mb plan_mb current
    disk_mb=$(linode_api "https://api.linode.com/v4/linode/instances/$id/disks" \
        | python3 -c "import sys,json;print(sum(d['size'] for d in json.load(sys.stdin)['data']))")
    plan_mb=$(linode_api "https://api.linode.com/v4/linode/types/$target" \
        | python3 -c "import sys,json;print(json.load(sys.stdin)['disk'])")
    current=$(linode_api "https://api.linode.com/v4/linode/instances/$id" \
        | python3 -c "import sys,json;print(json.load(sys.stdin)['type'])")

    # ── 1. Already there ────────────────────────────────────────────────────
    # A same-plan resize is NOT a no-op. Linode still migrates the instance to a
    # different physical host and still reboots it at the end -- verified on
    # pezware-cuatro, whose host_uuid changed across a resize. So the cost of a
    # typo repeated is a full outage for no capacity change.
    if [ "$target" = "$current" ]; then
        echo "error: $ROLE is already on $target." >&2
        echo "       A same-plan resize is not free: Linode migrates to a new host and" >&2
        echo "       reboots anyway. Refusing." >&2
        exit 1
    fi

    # ── 2. Disks must fit the target plan ───────────────────────────────────
    # Linode grows disks but never shrinks them, and we always send
    # allow_auto_disk_resize=false to keep the trip reversible. So a downsize is
    # only legal when the CURRENT allocation already fits. Without this check the
    # request is accepted and then fails minutes later in the events feed, which
    # reads as a platform fault rather than a request that was never valid.
    if [ "$disk_mb" -gt "$plan_mb" ]; then
        echo "error: disks occupy ${disk_mb} MB but $target allows only ${plan_mb} MB." >&2
        echo "       Linode does not shrink disks automatically. Shrink the disk first," >&2
        echo "       then retry — see 'Manage disks and storage on a Linode' in the" >&2
        echo "       Akamai docs. Refusing." >&2
        exit 1
    fi

    # ── 3. Nothing may be running ───────────────────────────────────────────
    # Warm resize keeps the instance up for the migration but reboots at the end,
    # and podman is daemonless: restart policies are replayed by
    # podman-restart.service, which is DISABLED on the devbox. So a reboot with
    # containers up loses them silently — the kind cluster included.
    #
    # Unreachable counts as "running". We cannot see the node's state, and
    # rebooting a box whose state is unknown is the case this guard exists for.
    local label running
    label=$(tf output -raw label 2>/dev/null) || label=""
    if [ -n "$label" ]; then
        running=$(tailscale ssh "$label" \
            'if command -v podman >/dev/null 2>&1; then podman ps -q | wc -l; else echo 0; fi' \
            2>/dev/null) || running=""
        running=$(printf '%s' "$running" | tr -d '[:space:]')
    else
        running=""
    fi

    if [ -z "$running" ]; then
        echo "error: cannot reach '$label' over the tailnet to check for running containers." >&2
        echo "       Refusing rather than rebooting a node whose state is unknown." >&2
        echo "       Override with TS_NODE_FORCE_RESIZE=1 if you know it is idle." >&2
        [ -n "${TS_NODE_FORCE_RESIZE:-}" ] || exit 1
        echo "       ... TS_NODE_FORCE_RESIZE set, continuing anyway." >&2
    elif [ "$running" -gt 0 ]; then
        echo "error: $running container(s) running on $label." >&2
        echo "       The resize ends in a reboot and nothing restarts them —" >&2
        echo "       podman-restart.service is disabled on this fleet. Stop them first:" >&2
        echo "         tailscale ssh $label 'podman stop -a'" >&2
        echo "       Override with TS_NODE_FORCE_RESIZE=1 to accept losing them." >&2
        [ -n "${TS_NODE_FORCE_RESIZE:-}" ] || exit 1
        echo "       ... TS_NODE_FORCE_RESIZE set, continuing anyway." >&2
    fi
}

tf() { terraform -chdir="$ROLE_DIR" "$@"; }

instance_id() { tf output -raw instance_id 2>/dev/null; }

# The Authorization header goes in via a stdin config file rather than argv,
# where any local process could read it out of /proc or `ps` while curl runs.
linode_api() {
    curl -sf -K - -H "Content-Type: application/json" "$@" <<CFG
header = "Authorization: Bearer ${LINODE_TOKEN}"
CFG
}

case "$CMD" in
    apply)
        needs_linode_token
        needs_auth_key
        [ -d "$ROLE_DIR/.terraform/providers" ] || tf init
        tf apply "$@"
        ;;
    plan)
        needs_linode_token
        needs_auth_key
        [ -d "$ROLE_DIR/.terraform/providers" ] || tf init
        tf plan "$@"
        ;;
    destroy)
        needs_linode_token
        # auth_key is required by the schema; empty satisfies it during destroy.
        TF_VAR_tailscale_auth_key=""
        tf destroy "$@"
        echo "Remember to remove the stale node from https://login.tailscale.com/admin/machines"
        ;;
    start)
        needs_linode_token
        ID=$(instance_id) || { echo "error: run './ts-node $ROLE apply' first" >&2; exit 1; }
        echo "Booting $ROLE (id $ID)..."
        linode_api -X POST "https://api.linode.com/v4/linode/instances/$ID/boot" >/dev/null
        echo "On the tailnet in ~60s."
        ;;
    stop)
        needs_linode_token
        ID=$(instance_id) || exit 1
        echo "Powering off $ROLE (id $ID)."
        echo "NOTE: Linode bills a powered-off instance in full. Only 'destroy' stops charges."
        linode_api -X POST "https://api.linode.com/v4/linode/instances/$ID/shutdown" >/dev/null
        ;;
    resize)
        # Scale a node up for a heavy test session and back down afterwards,
        # WITHOUT rebuilding it. This is an API operation, not a Terraform one,
        # for the same reason start/stop are: Terraform owns what the box IS,
        # the API owns what it is DOING. It also sidesteps the fact that any
        # `apply` replaces the instance whenever user_data has drifted.
        #
        # Keep roles/<role>/main.tf's `type` in step afterwards, or the next
        # apply will quietly resize the node back and cost another reboot.
        #
        # Measured on pezware-cuatro 2026-08-11: ~107 MB/s against the disk
        # ALLOCATION (not the used bytes), so a 25 GB disk took ~4 minutes and
        # the devbox's 79.5 GB root should take ~12. Warm keeps the instance up
        # for all of it; the only outage is the reboot at the end (~23 s there).
        needs_linode_token
        ID=$(instance_id) || { echo "error: run './ts-node $ROLE apply' first" >&2; exit 1; }
        TARGET="${1:-}"
        [ -n "$TARGET" ] || {
            echo "usage: ./ts-node $ROLE resize <plan>   e.g. g6-standard-4" >&2
            exit 1
        }

        resize_guard "$ID" "$TARGET"

        echo "Warm-resizing $ROLE (id $ID) to $TARGET."
        echo "NOTE: the instance stays up during the migration but IS rebooted at the end."
        echo "      Containers do not come back on their own — podman-restart.service is disabled."
        linode_api -X POST \
            -d "{\"type\":\"$TARGET\",\"migration_type\":\"warm\",\"allow_auto_disk_resize\":false}" \
            "https://api.linode.com/v4/linode/instances/$ID/resize" >/dev/null
        echo "Accepted. Watch with: ./ts-node $ROLE status"
        ;;
    sync-bootstrap)
        # Converge a RUNNING node onto the repo's current bootstrap scripts,
        # without the rebuild Terraform would otherwise insist on.
        #
        # This is the other half of `ignore_changes = [metadata]` in the module.
        # user_data only ever runs at first boot; from then on the live artifacts
        # are these two files, re-run every boot by 0x58-node-boot.service. So
        # replacing them and re-running the unit is the whole repair -- seconds,
        # against an hour of rebuild and six manual steps.
        #
        # No Linode token needed: this never touches the API.
        LABEL=$(tf output -raw label 2>/dev/null) || { echo "error: not applied" >&2; exit 1; }

        # Piped to `tee` under sudo rather than scp'd: Tailscale SSH is the only
        # access path and these land in /usr/local/sbin, which the login user
        # cannot write. Modes mirror cloud-init.yaml exactly (0755 root:root).
        for pair in "modules/linode-node/common.sh:/usr/local/sbin/node-common.sh" \
            "$ROLE_DIR/bootstrap.sh:/usr/local/sbin/node-bootstrap"; do
            src="${pair%%:*}"; dst="${pair##*:}"
            [ -f "$src" ] || { echo "error: $src missing" >&2; exit 1; }
            echo "→ $dst"
            tailscale ssh "$LABEL" \
                "sudo tee $dst >/dev/null && sudo chmod 0755 $dst && sudo chown root:root $dst" \
                < "$src" || { echo "error: failed to install $dst" >&2; exit 1; }
        done

        # restart, NOT start. The unit is Type=oneshot with RemainAfterExit=yes,
        # so between boots it sits in active(exited) -- and `systemctl start` on
        # an already-active unit is a no-op that exits 0. This command would then
        # copy both files, silently skip the reconcile, and print "active" from
        # is-active, looking for all the world like it had worked.
        #
        # RemainAfterExit is there so a successful oneshot stays distinguishable
        # from one that never ran. The same property is what makes `start` useless
        # here, which is why the two must be read together.
        #
        # --per-boot mode: skips package installs and cluster creation, so this is
        # the light reconcile and not a re-provision. Safe on a live node --
        # tailscale is already authenticated so it only reapplies identical flags,
        # the volume and swapfile are already in place, the unit file is cmp-
        # guarded, the tmux session is has-session guarded, and KillMode=process
        # keeps the cgroup teardown off the tmux server. Nothing touches podman.
        echo "→ re-running 0x58-node-boot.service (--per-boot reconcile)"
        tailscale ssh "$LABEL" 'sudo systemctl restart 0x58-node-boot.service' || {
            echo "error: reconcile failed — check: ssh $LABEL journalctl -u 0x58-node-boot.service -n50" >&2
            exit 1
        }

        # Prove it actually ran rather than trusting is-active, which reports
        # "active" for a unit that has not executed since the last boot.
        tailscale ssh "$LABEL" \
            'systemctl show 0x58-node-boot.service -p ExecMainStartTimestamp -p Result'
        echo "Synced. Confirm with: ssh $LABEL devbox-drift"
        ;;
    status)
        needs_linode_token
        ID=$(instance_id) || { echo "not applied"; exit 0; }
        linode_api "https://api.linode.com/v4/linode/instances/$ID" \
            | python3 -c "import sys,json; print(json.load(sys.stdin).get('status','?'))"
        ;;
    ssh)
        LABEL=$(tf output -raw label 2>/dev/null) || { echo "error: not applied" >&2; exit 1; }
        exec tailscale ssh "$LABEL" "$@"
        ;;
    ip)
        LABEL=$(tf output -raw label 2>/dev/null) || { echo "error: not applied" >&2; exit 1; }
        tailscale ip -4 "$LABEL"
        ;;
    *)
        usage 1
        ;;
esac
