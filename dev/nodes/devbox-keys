#!/usr/bin/env bash
#
# Escrow devbox secrets in the macOS Keychain, and seal them onto the devbox.
#
#   devbox-keys init      generate the ssh keys HERE, escrow, seal, print pubkeys
#   devbox-keys restore   seal every escrowed secret onto a (rebuilt) devbox
#   devbox-keys status    what exists where
#   devbox-keys save      escrow legacy on-disk ssh keys from a pre-seal devbox
#
# Runs ON THE MAC. Same direction and trust store as ts-node and backup-devbox.sh.
#
# WHAT GETS SEALED
#
#   ssh keys       Keychain devbox-sshkey-<name> -> linux/ssh-agent/install
#                  -> /etc/credstore.encrypted/ssh-<name>, loaded into a root-fed
#                  ssh-agent. ~/.ssh on the box holds only the public halves.
#   broker keys    each linux/secret-broker/routes/<route>.env that names a
#                  BROKER_ESCROW_ITEM -> linux/secret-broker/install --seal
#                  -> /etc/credstore.encrypted/<route>, behind a unix socket.
#
# Every secret crosses on stdin, never argv, so it never shows in `ps` on either
# end. Sealing needs sudo on the box, which a sandboxed session cannot use.
#
# WHY ESCROW
#
# The devbox signs commits with keys registered to two different GitHub accounts
# (see dev/nodes/README.md). Registration is manual and cannot be scripted -- it
# needs a browser session per account. So if a rebuild generated fresh keys, every
# rebuild would end with two manual GitHub registrations, which is precisely the
# kind of step that makes "rebuild in 10 minutes" a fiction.
#
# These keys are signing/auth identities, NOT the Secure Enclave keys. Those remain
# non-extractable and are never touched by this script.
# Remote commands interpolate $k locally on purpose (it is the key name), while ~
# stays literal inside double quotes and expands on the devbox. Both intended.
# shellcheck disable=SC2029
set -euo pipefail

REMOTE="${DEVBOX_HOST:-devbox}"
# The box's checkout of this repo, relative to its home.
REPO_ON_BOX="${DEVBOX_REPO:-src/public/0x58}"
KEYS=(devbox_agent devbox_agent_personal)
ROUTES_DIR="$(cd "$(dirname "$0")/../../linux/secret-broker/routes" && pwd)"

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
item_for() { printf 'devbox-sshkey-%s' "$1"; }
kc_get() { security find-generic-password -s "$1" -a "$USER" -w 2>/dev/null; }
# `security -i` reads the command from stdin, so the value never reaches argv.
kc_put() {   # $1 item   $2 comment   value on stdin
    local v; v="$(cat)"
    printf 'add-generic-password -U -s %s -a %s -j "%s" -w %s\n' "$1" "$USER" "$2" "$v" \
        | security -i >/dev/null
}

require_mac() {
    [ "$(uname -s)" = "Darwin" ] || die "runs on the Mac (the Keychain lives here)"
}

# A login shell, so mise puts go on PATH for the broker build.
on_box() { ssh -o ConnectTimeout=15 "$REMOTE" "bash -lc $(printf '%q' "cd ~/$REPO_ON_BOX && $1")"; }

route_item() { sed -n 's/^BROKER_ESCROW_ITEM=//p' "$1"; }

seal_ssh_key() {   # $1 key name
    local k="$1" b64
    b64=$(kc_get "$(item_for "$k")") || { echo "  ssh $k: not in Keychain, skipping"; return 0; }
    printf '%s' "$b64" | base64 -d | on_box "linux/ssh-agent/install --seal $k" >/dev/null \
        || die "ssh $k: sealing failed — run linux/ssh-agent/install on the box for the log"
    echo "  ssh $k: sealed ($(ssh "$REMOTE" "ssh-keygen -lf ~/.ssh/$k.pub | awk '{print \$2}'" 2>/dev/null))"
}

seal_route() {   # $1 route file
    local route item v
    route="$(basename "$1" .env)"
    item="$(route_item "$1")"
    [ -n "$item" ] || { echo "  route $route: no BROKER_ESCROW_ITEM, skipping"; return 0; }
    v=$(kc_get "$item") || { echo "  route $route: Keychain item $item missing, skipping"; return 0; }
    printf '%s' "$v" | on_box "linux/secret-broker/install --seal $route" >/dev/null \
        || die "route $route: sealing failed — run linux/secret-broker/install $route on the box"
    echo "  route $route: sealed from $item"
}

cmd_restore() {
    require_mac
    local k f
    for k in "${KEYS[@]}"; do seal_ssh_key "$k"; done
    for f in "$ROUTES_DIR"/*.env; do seal_route "$f"; done
    echo
    echo "  Public keys are derived from the escrowed private halves, so GitHub"
    echo "  registrations remain valid. Nothing to re-register."
}

cmd_init() {
    require_mac
    local k tmp
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' RETURN
    for k in "${KEYS[@]}"; do
        if kc_get "$(item_for "$k")" >/dev/null; then
            echo "  $k: already escrowed"
            continue
        fi
        # Generated on the Mac, so no private key is ever a file on the devbox.
        ssh-keygen -q -t ed25519 -N '' -C "${k}@pezware-devbox" -f "$tmp/$k"
        base64 < "$tmp/$k" | tr -d '\n' \
            | kc_put "$(item_for "$k")" "devbox agent ssh key, base64 -- reinstall with dev/nodes/devbox-keys restore"
        echo "  $k: generated and escrowed"
    done
    rm -rf "$tmp"
    for k in "${KEYS[@]}"; do seal_ssh_key "$k"; done
    echo
    echo "==> Register these, then they survive every rebuild:"
    echo "    devbox_agent          -> arbeitandy   (Authentication AND Signing)"
    echo "    devbox_agent_personal -> achtungandy  (Signing only)"
    echo
    for k in "${KEYS[@]}"; do
        printf '  %s:\n    ' "$k"
        ssh "$REMOTE" "cat ~/.ssh/$k.pub" 2>/dev/null
    done
}

# Only for a box from before the sealed agent: its keys still sit in ~/.ssh.
# `restore` then seals them and deletes the files.
cmd_save() {
    require_mac
    local k b64
    for k in "${KEYS[@]}"; do
        ssh -o ConnectTimeout=15 "$REMOTE" "test -f ~/.ssh/$k" 2>/dev/null \
            || { echo "  $k: no on-disk key on the devbox, skipping"; continue; }
        # base64 so the Keychain holds a single-line printable value, matching the
        # gpg-archive-b64 pattern already used for GPG cold storage.
        b64=$(ssh "$REMOTE" "base64 -w0 < ~/.ssh/$k" 2>/dev/null)
        [ -n "$b64" ] || die "$k: read back empty, refusing to store"
        printf '%s' "$b64" \
            | kc_put "$(item_for "$k")" "devbox agent ssh key, base64 -- reinstall with dev/nodes/devbox-keys restore"
        echo "  $k: escrowed ($(printf %s "$b64" | wc -c | tr -d ' ') b64 chars)"
    done
}

cmd_status() {
    local k f route item held
    held=$(ssh -o ConnectTimeout=15 "$REMOTE" 'SSH_AUTH_SOCK=/run/ssh-agent-$(id -un)/agent.sock ssh-add -l' 2>/dev/null || true)
    printf '  %-28s %-10s %s\n' SECRET KEYCHAIN DEVBOX
    for k in "${KEYS[@]}"; do
        fp=$(ssh -o ConnectTimeout=15 "$REMOTE" "ssh-keygen -lf ~/.ssh/$k.pub 2>/dev/null | awk '{print \$2}'" 2>/dev/null || true)
        printf '  %-28s %-10s %s\n' "ssh $k" \
            "$(kc_get "$(item_for "$k")" >/dev/null && echo present || echo MISSING)" \
            "$([ -n "$fp" ] && printf '%s' "$held" | grep -qF "$fp" && echo "in agent" || echo "NOT in agent")"
    done
    for f in "$ROUTES_DIR"/*.env; do
        route="$(basename "$f" .env)"
        item="$(route_item "$f")"
        printf '  %-28s %-10s %s\n' "route $route" \
            "$( [ -n "$item" ] && kc_get "$item" >/dev/null && echo present || echo MISSING)" \
            "$(ssh -o ConnectTimeout=15 "$REMOTE" "curl -fsS --unix-socket /run/$route-broker/$route.sock http://$route/healthz" >/dev/null 2>&1 \
                && echo serving || echo DOWN)"
    done
}

case "${1:-status}" in
    init)    cmd_init ;;
    save)    cmd_save ;;
    restore) cmd_restore ;;
    status)  cmd_status ;;
    *)       sed -n '3,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
