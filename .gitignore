# Python
__pycache__/
*.py[cod]
*.so

# Testing
.pytest_cache/
.hypothesis/

# Virtual environments
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store

# keymaster is compiled from macos/keymaster/keymaster.swift by restore.sh.
# Never commit the binary — a credential tool on PATH should be reproducible
# from the source in this repo, not a blob someone has to trust.
macos/keymaster/keymaster

# Local-only working contracts — never committed, never referenced in commits/PRs
IMPLEMENTATION_PLAN.md
IMPLEMENTATION_PLAN-*.md

# Terraform — never commit local state or downloaded providers (per-dir
# .gitignore files cover this too, but a top-level rule is belt-and-suspenders
# for any future Terraform path in the repo)
.terraform/
*.tfstate
*.tfstate.*
