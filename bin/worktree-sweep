#!/usr/bin/env python3
"""worktree-sweep — remove the worktrees whose branch already merged, and say
when this checkout has drifted from origin/main.

  worktree-sweep                 # report; touches nothing
  worktree-sweep --fetch         # fetch origin first, then report
  worktree-sweep --remove        # remove the merged, clean worktrees
  worktree-sweep --session-json  # one SessionStart line, silent when clean

WHY THIS EXISTS

A merged worktree is not harmless clutter. It holds a branch that is now a
second, stale answer to "what does this repo say", and it keeps a local branch
alive that `git branch -d` would happily retire. Two of them sat on the devbox
`.claude` checkout after PRs #16 and #17 merged, and nothing was ever going to
notice: src-sync skips worktrees ON PURPOSE, because five checkouts sharing one
object store raced for ref locks and four of them lost.

So the tree that src-sync deliberately ignores needs its own sweeper.

The drift half answers the other question nobody asks often enough: how far has
origin/main moved under this branch. A rebase is cheap on the day the work
lands and expensive a week later.

WHAT COUNTS AS MERGED

Containment first: `merge-base --is-ancestor <branch> origin/main`. That is
offline, exact for a merge commit, and these repos merge with one.

A SQUASH merge leaves no such ancestry, so a branch that fails containment is
put to `gh pr list --head <branch> --state merged` when gh is available. When gh
cannot answer, the branch is reported as UNKNOWN and never removed. Guessing
"merged" costs someone their work; guessing "unmerged" costs a line of output.

WHAT IT REFUSES TO REMOVE

  - a worktree with modified tracked files. That is somebody mid-thought.
  - the worktree you are standing in.
  - anything it could not prove merged.

On Linux it removes through `devbox-worktree-rm` when that exists: a sandboxed
session bind-masks the worktree metadata and recomputes it on every Bash call,
so plain `git worktree remove` cannot work there and --force fails identically.
"""
import json
import os
import shutil
import subprocess
import sys
import time

FETCH_STALE = 6 * 3600  # seconds before origin/main is worth refetching


def git(repo, *args, timeout=10):
    try:
        r = subprocess.run(["git", "-C", repo, *args],
                           capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def git_ok(repo, *args, timeout=10):
    try:
        return subprocess.run(["git", "-C", repo, *args], capture_output=True,
                              text=True, timeout=timeout).returncode == 0
    except Exception:
        return False


def worktrees(repo):
    """[(path, branch|None), ...]; git lists the primary checkout first."""
    out = git(repo, "worktree", "list", "--porcelain")
    if not out:
        return []
    items, cur = [], {}
    for line in out.splitlines():
        if line.startswith("worktree "):
            if cur:
                items.append((cur["path"], cur.get("branch")))
            cur = {"path": line.split(" ", 1)[1]}
        elif line.startswith("branch "):
            cur["branch"] = line.split(" ", 1)[1].replace("refs/heads/", "")
    if cur:
        items.append((cur["path"], cur.get("branch")))
    return items


def default_ref(repo):
    head = git(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if head:
        return head
    for name in ("main", "master"):
        if git(repo, "rev-parse", "--verify", f"refs/remotes/origin/{name}"):
            return f"origin/{name}"
    return None


def merged_via_gh(repo, branch):
    """True / False / None(unknown). Best effort, short leash."""
    if not shutil.which("gh"):
        return None
    try:
        r = subprocess.run(
            ["gh", "pr", "list", "--head", branch, "--state", "merged",
             "--json", "number", "--limit", "1"],
            cwd=repo, capture_output=True, text=True, timeout=15)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    try:
        return len(json.loads(r.stdout or "[]")) > 0
    except Exception:
        return None


def dirty(path):
    out = git(path, "status", "--porcelain", "--untracked-files=no")
    return bool(out)


def fetch_age(repo):
    common = git(repo, "rev-parse", "--git-common-dir")
    if not common:
        return None
    if not os.path.isabs(common):
        common = os.path.join(repo, common)
    try:
        return time.time() - os.path.getmtime(os.path.join(common, "FETCH_HEAD"))
    except OSError:
        return None


def survey(repo, ref, use_gh=True):
    """Classify every worktree except the primary checkout."""
    rows = []
    for path, branch in worktrees(repo)[1:]:
        if not branch:
            rows.append((path, None, "detached"))
            continue
        if git(repo, "rev-parse", branch) == git(repo, "rev-parse", ref):
            # A branch sitting exactly on origin/main has no commits of its own.
            # Containment calls that "merged"; it is a worktree somebody just
            # made and has not written in yet. Sweeping it would be a theft of
            # setup, so it is kept and named for what it is.
            state = "fresh"
        elif git_ok(repo, "merge-base", "--is-ancestor", branch, ref):
            state = "merged"
        else:
            bygh = merged_via_gh(path, branch) if use_gh else None
            state = "merged" if bygh else ("unmerged" if bygh is False else "unknown")
        if state == "merged" and dirty(path):
            state = "merged-dirty"
        rows.append((path, branch, state))
    return rows


def remove(repo, path, branch):
    """Prefer devbox-worktree-rm on Linux; the sandbox defeats the plain form."""
    helper = shutil.which("devbox-worktree-rm")
    cmd = [helper, path] if (helper and sys.platform.startswith("linux")) \
        else ["git", "-C", repo, "worktree", "remove", path]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except Exception as e:
        return False, str(e)
    if r.returncode != 0:
        return False, (r.stderr or r.stdout).strip().splitlines()[-1:] or ["failed"]
    # -d refuses an unmerged branch, which is the safety we want here.
    git(repo, "branch", "-d", branch)
    return True, None


def main():
    args = set(sys.argv[1:])
    session = "--session-json" in args

    repo = git(os.getcwd(), "rev-parse", "--show-toplevel")
    if not repo:
        sys.exit(0 if session else "worktree-sweep: not inside a git repo")

    if "--fetch" in args:
        git(repo, "fetch", "origin", timeout=60)

    ref = default_ref(repo)
    if not ref:
        sys.exit(0 if session else "worktree-sweep: cannot resolve origin/HEAD")

    # The session line must not make network calls; gh would.
    rows = survey(repo, ref, use_gh=not session)
    merged = [r for r in rows if r[2] == "merged"]
    behind = git(repo, "rev-list", "--count", f"HEAD..{ref}") or "0"
    age = fetch_age(repo)

    if session:
        notes = []
        if merged:
            names = ", ".join(os.path.basename(p) for p, _, _ in merged[:3])
            more = f" (+{len(merged) - 3})" if len(merged) > 3 else ""
            notes.append(f"{len(merged)} merged worktree(s) — {names}{more}. "
                         f"Remove with `worktree-sweep --remove`.")
        if behind != "0":
            notes.append(f"This branch is {behind} behind {ref}; "
                         f"rebase before the gap grows.")
        if age and age > FETCH_STALE:
            notes.append(f"origin last fetched {int(age // 3600)}h ago — "
                         f"`worktree-sweep --fetch` re-reads it.")
        if notes:
            json.dump({"hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": f"{os.path.basename(repo)}: " + " ".join(notes),
            }}, sys.stdout)
        sys.exit(0)

    print(f"# {repo}  (default {ref}, HEAD is {behind} behind)")
    if age:
        print(f"# origin last fetched {int(age // 3600)}h ago")
    if not rows:
        print("no worktrees besides the primary checkout")
    for path, branch, state in rows:
        print(f"  {state:14} {branch or '(detached)':38} {path}")

    if "--remove" not in args:
        if merged:
            print(f"\n{len(merged)} removable. Run: worktree-sweep --remove")
        return

    if not merged:
        print("\nnothing to remove")
        return
    here = git(os.getcwd(), "rev-parse", "--show-toplevel")
    print()
    for path, branch, _ in merged:
        if os.path.realpath(path) == os.path.realpath(here or ""):
            print(f"  KEPT    {path} — you are standing in it")
            continue
        ok, err = remove(repo, path, branch)
        print(f"  {'REMOVED' if ok else 'FAILED '} {path}" + (f" — {err}" if err else ""))


if __name__ == "__main__":
    main()
